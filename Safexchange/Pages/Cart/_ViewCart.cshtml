@model Safexchange.Pages.Cart.IndexModel

@if (!Model.Items.Any())
{
    <p class="text-muted mb-0">Giỏ hàng của bạn đang trống.</p>
}
else
{
    <div class="mb-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="cart-select-all" checked onchange="Cart.toggleSelectAll(this.checked)" />
            <label class="form-check-label small" for="cart-select-all">Chọn tất cả</label>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-3">
            <thead>
                <tr>
                    <th style="width:36px;"></th>
                    <th>Sản phẩm</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Tạm tính</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="form-check-input cart-item-select"
                                   value="@item.ProductId" checked data-price="@item.LineTotal" />
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="" class="cart-item-thumb rounded" />
                                }
                                <span>@item.Title</span>
                            </div>
                        </td>
                        <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end fw-semibold">@item.LineTotal.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center border-top pt-3">
        <div>
            <div class="small text-muted">Đã chọn: <span id="cart-selected-count">@Model.Items.Count</span> sản phẩm</div>
            <strong>Tạm tính: <span id="cart-selected-total">@Model.Total.ToString("N0")</span> đ</strong>
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="Cart.openEdit()">Chỉnh sửa giỏ</button>
            <button type="button" class="btn btn-primary btn-sm" onclick="Cart.goToCheckout()">Thanh toán</button>
        </div>
    </div>
}
