@page
@model Safexchange.Pages.Admin.UserManagement.PendingVerificationsModel

@{
    ViewData["Title"] = "Danh sách xác thực người dùng";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid text-start px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-dark fw-bold">Xác thực người dùng</h2>
            <p class="text-muted mb-0">Danh sách các minh chứng xác thực danh tính thành viên.</p>
        </div>
        <div>
            <a asp-page="./Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">Người dùng</th>
                            <th>Loại xác thực</th>
                            <th>Giá trị</th>
                            <th>Minh chứng</th>
                            <th>Trạng thái</th>
                            <th>Ngày gửi</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UserVerifications)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@item.User.FullName</div>
                                    <div class="small text-muted">@item.User.Email</div>
                                </td>
                                <td>@item.VerificationType</td>
                                <td>@item.VerificationValue</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.DocumentUrl))
                                    {
                                        <a href="@item.DocumentUrl" target="_blank" class="btn btn-sm btn-link p-0">
                                            <i class="fas fa-file-alt me-1"></i>Xem file
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có file</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>
                                    }
                                    else if (item.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success text-white px-2 py-1">Đã duyệt</span>
                                    }
                                    else if (item.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1" title="@item.RejectionReason">Từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white px-2 py-1">@item.Status</span>
                                    }
                                </td>
                                <td class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    @if (item.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@item.VerificationId" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success mb-1" onclick="return confirm('Bạn có chắc chắn muốn duyệt?')">
                                                <i class="fas fa-check"></i> Duyệt
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-danger mb-1" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.VerificationId">
                                            <i class="fas fa-times"></i> Từ chối
                                        </button>

                                        <!-- Modal Từ chối -->
                                        <div class="modal fade" id="rejectModal-@item.VerificationId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="post" asp-page-handler="Reject" asp-route-id="@item.VerificationId">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Lý do từ chối - @item.User.FullName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <div class="mb-3">
                                                                <label class="form-label">Lý do</label>
                                                                <textarea name="reason" class="form-control" rows="3" required placeholder="Nhập lý do từ chối..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light text-muted mb-1" disabled>
                                            <i class="fas fa-minus-circle"></i> No action
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.UserVerifications.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-folder-open fa-3x text-light mb-3"></i>
                        <p class="text-muted">Không có dữ liệu xác thực nào.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
