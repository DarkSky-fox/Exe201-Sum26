@page
@model Safexchange.Pages.Admin.UserManagement.IndexModel

@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid text-start px-4 mt-4">
    <!-- Tiêu đề và Thanh công cụ điều hướng nhanh -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-dark fw-bold">Quản lý Người dùng</h2>
            <p class="text-muted mb-0">Danh sách thành viên tham gia hệ thống Safexchange.</p>
        </div>
        <div class="d-flex gap-2">
            <!-- Nút xem danh sách duyệt minh chứng (User_Verification) -->
            <a asp-page="./PendingVerifications" class="btn btn-outline-dark shadow-sm">
                <i class="fas fa-user-check me-2"></i>Xem danh sách xác thực
            </a>

            <!-- Nút thêm tài khoản mới -->
            <a asp-page="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-user-plus me-2"></i>Thêm người dùng mới
            </a>
        </div>
    </div>

    <!-- Bảng danh sách dữ liệu -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.User[0].FullName)</th>
                            <th>@Html.DisplayNameFor(model => model.User[0].Email)</th>
                            <th>@Html.DisplayNameFor(model => model.User[0].Phone)</th>
                            <th>@Html.DisplayNameFor(model => model.User[0].Role)</th>
                            <th>Khóa học (Year)</th>
                            <th>@Html.DisplayNameFor(model => model.User[0].AccountStatus)</th>
                            <th>@Html.DisplayNameFor(model => model.User[0].CreatedAt)</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.User)
                        {
                            var isAdmin = item.Role?.ToString().Equals("Admin", StringComparison.OrdinalIgnoreCase) ?? false;
                            <tr>
                                <!-- Họ và tên -->
                                <td class="ps-4 fw-semibold text-dark">
                                    @Html.DisplayFor(modelItem => item.FullName)
                                </td>

                                <!-- Email -->
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>

                                <!-- Số điện thoại -->
                                <td>
                                    @(string.IsNullOrEmpty(item.Phone) ? "---" : item.Phone)
                                </td>

                                <!-- Phân quyền hệ thống -->
                                <td>
                                    @if (isAdmin)
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1">Admin</span>
                                    }
                                    else if (item.Role?.ToString().Equals("Shipper", StringComparison.OrdinalIgnoreCase) ?? false)
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-2 py-1">Shipper</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info px-2 py-1">Sinh viên</span>
                                    }
                                </td>

                                <!-- Khóa học -->
                                <td>
                                    <span class="text-secondary fw-medium">K@(item.YearLevel)</span>
                                </td>

                                <!-- Trạng thái tài khoản -->
                                <td>
                                    @if (item.AccountStatus?.ToString().Equals("Active", StringComparison.OrdinalIgnoreCase) ?? false)
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-2 py-1">Active</span>
                                    }
                                    else if (item.AccountStatus?.ToString().Equals("Suspended", StringComparison.OrdinalIgnoreCase) ?? false)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1">Suspended</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white rounded-pill px-2 py-1">@item.AccountStatus</span>
                                    }
                                </td>

                                <!-- Thời gian tham gia -->
                                <td class="text-muted small">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    warm
                                </td>

                                <!-- Cột hành động có tên nút rõ ràng -->
                                <td class="text-end pe-4" style="white-space: nowrap;">
                                    @if (isAdmin)
                                    {
                                        <button class="btn btn-sm btn-light text-muted mb-1" disabled>
                                            <i class="fas fa-shield-alt me-1"></i>Xác thực
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-page="./Verify" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-warning mb-1">
                                            <i class="fas fa-shield-alt me-1"></i>Xác thực
                                        </a>
                                    }

                                    <a asp-page="./Details" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-secondary mb-1">
                                        <i class="fas fa-eye"></i> Xem
                                    </a>

                                    <a asp-page="./Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary mb-1">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>

                                    <a asp-page="./Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-danger mb-1">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Khởi chạy Tooltip Bootstrap để hiển thị gợi ý (nếu cần dùng) -->
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}