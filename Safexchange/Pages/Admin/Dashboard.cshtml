@page
@model Safexchange.Pages.Admin.DashboardModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard Thống Kê</h2>
        <a asp-page="/Index" class="btn btn-outline-secondary">
            <i class="bi bi-house-door"></i> Quay về trang chủ
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Tổng số sản phẩm</h5>
                    <p class="card-text fs-2">--</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Người dùng mới</h5>
                    <p class="card-text fs-2">--</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Yêu cầu mượn sách</h5>
                    <p class="card-text fs-2">--</p>
                </div>
            </div>
        </div>
    </div>
</div>