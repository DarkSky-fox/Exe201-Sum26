@page
@model Safexchange.Pages.IndexModel
@{
    ViewData["Title"] = "Trang Chủ";
    ViewData["FullWidth"] = true;
}

<div class="home-page">

    <section class="hero-section text-white d-flex align-items-center">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold mb-4">
                        Chợ đồ cũ dành cho sinh viên
                    </h1>
                    <p class="lead mb-4">
                        Mua bán đồ dùng cũ an toàn trong cộng đồng sinh viên.
                        Tiết kiệm chi phí, giảm rác thải và hỗ trợ bạn bè.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-page="/Products/Index" class="btn btn-light btn-lg px-4">
                            Mua ngay
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Seller/Index" class="btn btn-outline-light btn-lg px-4">
                                Bán hàng
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Login" asp-route-returnUrl="/Seller/Index" class="btn btn-outline-light btn-lg px-4">
                                Bán hàng
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-6 text-center mt-4 mt-lg-0">
                    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f"
                         class="img-fluid hero-img"
                         alt="sinh viên">
                </div>
            </div>
        </div>
    </section>

    <section class="search-section py-4 bg-white shadow-sm">
        <div class="container">
            <form method="get" asp-page="/Products/Index">
                <div class="input-group input-group-lg">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Tìm laptop, bàn, ghế, sách..." />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i>
                        Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Danh mục sản phẩm</h2>
                <a asp-page="/Products/Index" class="text-decoration-none">Xem tất cả</a>
            </div>
            <div class="row g-4">
                @if (Model.Categories.Any())
                {
                    @foreach (var cat in Model.Categories)
                    {
                        <div class="col-lg-2 col-md-4 col-6">
                            <a asp-page="/Products/Index"
                               asp-route-category="@cat.CategoryName"
                               class="text-decoration-none">
                                <div class="category-card">
                                    <i class="bi @IndexModel.GetCategoryIcon(cat.CategoryName)"></i>
                                    <h6>@cat.CategoryName</h6>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    foreach (var item in new (string Name, string Icon)[]
                    {
                        ("Đồ điện tử", "bi-laptop"),
                        ("Đồ học tập", "bi-pencil-square"),
                        ("Sách/Giáo trình", "bi-book"),
                        ("Đồ phòng trọ", "bi-house-door"),
                        ("Combo phòng trọ", "bi-box-seam"),
                        ("Thời trang sinh viên", "bi-bag-heart")
                    })
                    {
                        <div class="col-lg-2 col-md-4 col-6">
                            <a asp-page="/Products/Index"
                               asp-route-category="@item.Name"
                               class="text-decoration-none">
                                <div class="category-card">
                                    <i class="bi @item.Icon"></i>
                                    <h6>@item.Name</h6>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <section class="py-5 vip-section">
        <div class="container">
            <div class="mb-4">
                <h2 class="fw-bold vip-title mb-1">👑 Sản phẩm VIP nổi bật</h2>
                <p class="text-muted mb-0">Sản phẩm gói quảng cáo cao cấp nhất</p>
            </div>
            @if (!Model.VipProducts.Any())
            {
                <div class="alert alert-warning rounded-4 mb-0">Chưa có sản phẩm VIP.</div>
            }
            else
            {
                <div class="row g-4 flex-nowrap overflow-auto pb-2">
                    @foreach (var product in Model.VipProducts)
                    {
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="product-card vip-card h-100">
                                <div class="vip-badge">VIP</div>
                                <div class="product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                                    {
                                        <img src="@product.CoverImageUrl" class="product-img" alt="@product.Title" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/400x300?text=No+Image" class="product-img" alt="@product.Title" />
                                    }
                                </div>
                                <div class="p-3 d-flex flex-column h-100">
                                    <h5 class="product-title">@product.Title</h5>
                                    <p class="small text-muted">Người bán: @product.SellerName</p>
                                    <div class="mb-3">
                                        <span class="product-price">@product.Price.ToString("N0") đ</span>
                                    </div>
                                    <a asp-page="/Products/Detail"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-warning btn-sm mt-auto fw-bold">
                                        Xem VIP
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">🔥 Sản phẩm quảng cáo</h2>
                <p class="text-muted mb-0">Sản phẩm được đẩy tin bởi gói quảng cáo</p>
            </div>
            @if (!Model.SponsoredProducts.Any())
            {
                <div class="alert alert-info rounded-4 mb-0">Chưa có sản phẩm quảng cáo.</div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var product in Model.SponsoredProducts)
                    {
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="product-card h-100">
                                <div class="product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                                    {
                                        <img src="@product.CoverImageUrl" class="product-img" alt="@product.Title" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/400x300?text=No+Image" class="product-img" alt="@product.Title" />
                                    }
                                    <span class="badge bg-warning text-dark product-badge">Quảng cáo</span>
                                </div>
                                <div class="p-3 d-flex flex-column h-100">
                                    <h5 class="product-title">@product.Title</h5>
                                    <p class="small text-muted">Người bán: @product.SellerName</p>
                                    <div class="mb-3">
                                        <span class="product-price">@product.Price.ToString("N0") đ</span>
                                    </div>
                                    <a asp-page="/Products/Detail"
                                       asp-route-id="@product.ProductId"
                                       class="btn btn-primary btn-sm mt-auto">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Sản phẩm nổi bật</h2>
                <a asp-page="/Products/Index" class="text-decoration-none">Xem tất cả</a>
            </div>
            @if (!Model.Products.Any())
            {
                <div class="alert alert-info rounded-4 shadow-sm mb-0">Chưa có sản phẩm nào.</div>
            }
            else
            {
                <div class="row g-4 flex-nowrap overflow-auto pb-2">
                    @foreach (var product in Model.Products.Take(6))
                    {
                        <div class="col-6 col-md-4 col-lg-2">
                            <div class="product-card h-100">
                                <div class="product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                                    {
                                        <img src="@product.CoverImageUrl" class="product-img" alt="@product.Title" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/400x300?text=No+Image" class="product-img" alt="@product.Title" />
                                    }
                                    <span class="badge bg-primary product-badge">@product.CategoryName</span>
                                </div>
                                <div class="p-3 d-flex flex-column h-100">
                                    <h5 class="product-title">@product.Title</h5>
                                    <p class="text-muted small mb-2">@product.ConditionStatus</p>
                                    <p class="small text-muted mb-3">Người bán: @product.SellerName</p>
                                    <div class="mb-3">
                                        <span class="product-price">@product.Price.ToString("N0") đ</span>
                                    </div>
                                    <div class="mt-auto d-flex gap-2">
                                        <a asp-page="/Products/Detail"
                                           asp-route-id="@product.ProductId"
                                           class="btn btn-outline-primary btn-sm flex-fill">
                                            Chi tiết
                                        </a>
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <button type="button"
                                                    class="btn btn-primary btn-sm flex-fill"
                                                    onclick="Cart.add(@product.ProductId)">
                                                Thêm giỏ
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="/Login" class="btn btn-primary btn-sm flex-fill">
                                                Đăng nhập
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="bi bi-shield-check"></i>
                        <h4>Giao dịch an toàn</h4>
                        <p>Tài khoản sinh viên xác thực giúp mua bán tin cậy hơn.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="bi bi-cash-stack"></i>
                        <h4>Giá phải chăng</h4>
                        <p>Mua đồ cũ với mức giá tiết kiệm dành cho sinh viên.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="bi bi-recycle"></i>
                        <h4>Bền vững</h4>
                        <p>Giảm rác thải và bảo vệ môi trường.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>
