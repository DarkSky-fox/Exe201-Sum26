@page
@model Safexchange.Pages.IndexModel
@using Safexchange.Pages.Shared
@{
    ViewData["Title"] = "Trang Chủ";
    ViewData["FullWidth"] = true;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="home-page">

    <!-- Hero Section - Enhanced -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="hero-badge mb-3">
                        <span class="badge-trust">
                            <i class="bi bi-shield-check"></i>
                            Được tin cậy bởi 10,000+ sinh viên
                        </span>
                    </div>
                    <h1 class="display-4 fw-bold mb-3">
                        Chợ đồ cũ dành cho sinh viên
                    </h1>
                    <p class="lead mb-4" style="color: rgba(255,255,255,0.85);">
                        Mua bán đồ dùng cũ an toàn trong cộng đồng sinh viên.
                        Tiết kiệm chi phí, giảm rác thải và hỗ trợ bạn bè.
                    </p>
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <a asp-page="/Products/Index" class="btn btn-light btn-lg px-4 fw-semibold">
                            <i class="bi bi-bag me-2"></i>Mua ngay
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Seller/Index" class="btn btn-outline-light btn-lg px-4 fw-semibold">
                                <i class="bi bi-plus-circle me-2"></i>Bán hàng
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Login" asp-route-returnUrl="/Seller/Index" class="btn btn-outline-light btn-lg px-4 fw-semibold">
                                <i class="bi bi-plus-circle me-2"></i>Bán hàng
                            </a>
                        }
                    </div>
                    <!-- Trust Badges -->
                    <div class="hero-trust-badges">
                        <div class="trust-item">
                            <i class="bi bi-shield-lock"></i>
                            <span>Escrow bảo vệ</span>
                        </div>
                        <div class="trust-item">
                            <i class="bi bi-credit-card"></i>
                            <span>Thanh toán an toàn</span>
                        </div>
                        <div class="trust-item">
                            <i class="bi bi-people-fill"></i>
                            <span>Sinh viên Việt Nam</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 text-center mt-5 mt-lg-0">
                    <div class="hero-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f"
                             class="img-fluid hero-img"
                             alt="sinh viên mua bán đồ cũ">
                        <!-- Floating Stats -->
                        <div class="hero-stat hero-stat-1">
                            <div class="stat-icon"><i class="bi bi-bag-check"></i></div>
                            <div class="stat-info">
                                <strong>50+</strong>
                                <span>Sản phẩm</span>
                            </div>
                        </div>
                        <div class="hero-stat hero-stat-2">
                            <div class="stat-icon"><i class="bi bi-emoji-smile"></i></div>
                            <div class="stat-info">
                                <strong>99%</strong>
                                <span>Hài lòng</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Search Bar - Enhanced -->
    <section class="search-section py-4">
        <div class="container">
            <form method="get" asp-page="/Products/Index" class="search-form">
                <div class="search-wrapper">
                    <div class="search-input-group">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               name="search"
                               class="form-control form-control-lg"
                               placeholder="Tìm laptop, bàn, ghế, sách..." />
                    </div>
                    <button class="btn btn-primary btn-lg" type="submit">
                        <i class="bi bi-search"></i>
                        Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Danh mục sản phẩm</h2>
                <a asp-page="/Products/Index" class="text-decoration-none">Xem tất cả</a>
            </div>
            <div class="row g-4">
                @if (Model.Categories.Any())
                {
                    @foreach (var cat in Model.Categories)
                    {
                        <div class="col-lg-2 col-md-4 col-6">
                            <a asp-page="/Products/Index"
                               asp-route-category="@cat.CategoryName"
                               class="text-decoration-none">
                                <div class="category-card">
                                    <i class="bi @IndexModel.GetCategoryIcon(cat.CategoryName)"></i>
                                    <h6>@cat.CategoryName</h6>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    foreach (var item in new (string Name, string Icon)[]
                    {
                        ("Đồ điện tử", "bi-laptop"),
                        ("Đồ học tập", "bi-pencil-square"),
                        ("Sách/Giáo trình", "bi-book"),
                        ("Đồ phòng trọ", "bi-house-door"),
                        ("Combo phòng trọ", "bi-box-seam"),
                        ("Thời trang sinh viên", "bi-bag-heart")
                    })
                    {
                        <div class="col-lg-2 col-md-4 col-6">
                            <a asp-page="/Products/Index"
                               asp-route-category="@item.Name"
                               class="text-decoration-none">
                                <div class="category-card">
                                    <i class="bi @item.Icon"></i>
                                    <h6>@item.Name</h6>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <section class="py-5 vip-section">
        <div class="container">
            <div class="mb-4">
                <h2 class="fw-bold vip-title mb-1">👑 Sản phẩm VIP nổi bật</h2>
                <p class="text-muted mb-0">Sản phẩm gói quảng cáo cao cấp nhất</p>
            </div>
            @if (!Model.VipProducts.Any())
            {
                <div class="alert alert-warning rounded-4 mb-0">Chưa có sản phẩm VIP.</div>
            }
            else
            {
                <div class="home-product-track">
                    @foreach (var product in Model.VipProducts)
                    {
                        <partial name="Shared/_HomeProductCard" model="IndexModel.ToCard(product, HomeProductCardVariant.Vip, isAuthenticated)" />
                    }
                </div>
            }
        </div>
    </section>

    <section class="py-5 section-muted">
        <div class="container">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">🔥 Sản phẩm quảng cáo</h2>
                <p class="text-muted mb-0">Sản phẩm được đẩy tin bởi gói quảng cáo</p>
            </div>
            @if (!Model.SponsoredProducts.Any())
            {
                <div class="alert alert-info rounded-4 mb-0">Chưa có sản phẩm quảng cáo.</div>
            }
            else
            {
                <div class="home-product-grid">
                    @foreach (var product in Model.SponsoredProducts)
                    {
                        <partial name="Shared/_HomeProductCard" model="IndexModel.ToCard(product, HomeProductCardVariant.Sponsored, isAuthenticated)" />
                    }
                </div>
            }
        </div>
    </section>

    <section class="py-5 section-muted">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Sản phẩm nổi bật</h2>
                <a asp-page="/Products/Index" class="text-decoration-none">Xem tất cả</a>
            </div>
            @if (!Model.Products.Any())
            {
                <div class="alert alert-info rounded-4 shadow-sm mb-0">Chưa có sản phẩm nào.</div>
            }
            else
            {
                <div class="home-product-track">
                    @foreach (var product in Model.Products.Take(6))
                    {
                        <partial name="Shared/_HomeProductCard" model="IndexModel.ToCard(product, HomeProductCardVariant.Featured, isAuthenticated, showCartActions: true)" />
                    }
                </div>
            }
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="bi bi-shield-check"></i>
                        <h4>Giao dịch an toàn</h4>
                        <p>Tài khoản sinh viên xác thực giúp mua bán tin cậy hơn.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="bi bi-cash-stack"></i>
                        <h4>Giá phải chăng</h4>
                        <p>Mua đồ cũ với mức giá tiết kiệm dành cho sinh viên.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="bi bi-recycle"></i>
                        <h4>Bền vững</h4>
                        <p>Giảm rác thải và bảo vệ môi trường.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>
