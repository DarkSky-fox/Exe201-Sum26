@page
@model Safexchange.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="row g-4">
    <div class="col-lg-7">
        <h1 class="h4 mb-3">Thông tin giao hàng</h1>
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <form method="post" id="checkout-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Form.ReceiverName" class="form-label fw-semibold"></label>
                        <input asp-for="Form.ReceiverName" class="form-control" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="Form.ReceiverName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Form.Phone" class="form-control" placeholder="0912345678" />
                        <span asp-validation-for="Form.Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.AddressLine" class="form-label fw-semibold"></label>
                        <textarea asp-for="Form.AddressLine" class="form-control" rows="3"
                                  placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>
                        <span asp-validation-for="Form.AddressLine" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Note" class="form-label fw-semibold"></label>
                        <input asp-for="Form.Note" class="form-control" placeholder="Giao giờ hành chính, gọi trước khi giao..." />
                    </div>

                    <div class="alert alert-light border mb-0">
                        <div class="fw-semibold mb-1">Phương thức thanh toán</div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" checked disabled id="payCod" />
                            <label class="form-check-label" for="payCod">
                                Thanh toán khi nhận hàng (COD)
                            </label>
                        </div>
                        <small class="text-muted">Bạn thanh toán trực tiếp cho shipper sau khi nhận và kiểm tra hàng.</small>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h5 mb-3">Đơn hàng (@Model.Items.Count sản phẩm)</h2>
        <div class="card shadow-sm border-0">
            <div class="card-body">
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="" class="rounded checkout-thumb" />
                        }
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@item.Title</div>
                            <div class="text-muted small">SL: @item.Quantity × @item.UnitPrice.ToString("N0") đ</div>
                            <div class="text-end fw-semibold">@item.LineTotal.ToString("N0") đ</div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mb-2">
                    <span>Tạm tính</span>
                    <span>@Model.Subtotal.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-muted">
                    <span>Phí giao hàng (ước tính)</span>
                    <span>@Model.EstimatedShipping.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3">
                    <span>Tổng thanh toán</span>
                    <span class="text-danger">@Model.EstimatedTotal.ToString("N0") đ</span>
                </div>

                <button type="submit" form="checkout-form" class="btn btn-danger w-100 mt-3 py-2">
                    Đặt hàng
                </button>
                <a asp-page="/Products/Index" class="btn btn-link w-100 mt-2">Tiếp tục mua sắm</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
