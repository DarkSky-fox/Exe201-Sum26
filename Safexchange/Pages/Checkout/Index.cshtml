@page
@model Safexchange.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Thanh toán</h1>
    <a asp-page="/Products/Index" class="btn btn-outline-secondary btn-sm">Tiếp tục mua sắm</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Thông tin khách hàng</h2>
            </div>
            <div class="card-body">
                @if (Model.Customer is null)
                {
                    <p class="text-muted mb-0">Không tìm thấy thông tin khách hàng.</p>
                }
                else
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Họ tên</dt>
                        <dd class="col-sm-8">@Model.Customer.FullName</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Customer.Email</dd>
                        <dt class="col-sm-4">Số điện thoại</dt>
                        <dd class="col-sm-8">@Model.Customer.Phone</dd>
                    </dl>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Địa chỉ giao hàng</h2>
            </div>
            <div class="card-body">
                @if (Model.DeliveryAddress is null)
                {
                    <p class="text-muted mb-0">Chưa có địa chỉ giao hàng. Vui lòng cập nhật địa chỉ trong tài khoản.</p>
                }
                else
                {
                    <p class="mb-1"><strong>@Model.DeliveryAddress.ReceiverName</strong> · @Model.DeliveryAddress.Phone</p>
                    <p class="mb-1">@Model.DeliveryAddress.AddressLine</p>
                    <p class="mb-1 text-muted">@Model.DeliveryAddress.AreaDisplay</p>
                    <span class="badge bg-light text-dark border">@Model.DeliveryAddress.AddressType</span>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Phương thức thanh toán</h2>
            </div>
            <div class="card-body">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="paymentCod" checked disabled />
                    <label class="form-check-label" for="paymentCod">
                        @IndexModel.CodPaymentMethod
                    </label>
                </div>
                <p class="text-muted small mb-0 mt-2">Hiện chỉ hỗ trợ thanh toán khi nhận hàng (COD).</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm checkout-summary-sticky">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Thông tin đơn hàng</h2>
                @if (Model.OrderCountPreview > 1)
                {
                    <p class="small text-muted mb-0 mt-1">Sẽ tạo @Model.OrderCountPreview đơn hàng (mỗi sản phẩm một đơn).</p>
                }
            </div>
            <div class="card-body p-0">
                @if (!Model.LineItems.Any())
                {
                    <p class="text-muted p-3 mb-0">Không có sản phẩm hợp lệ để đặt.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.LineItems)
                        {
                            <li class="list-group-item">
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="" class="cart-item-thumb rounded flex-shrink-0" />
                                    }
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="fw-semibold text-truncate">@item.Title</div>
                                        <div class="small text-muted">
                                            @item.UnitPrice.ToString("N0") đ × @item.Quantity
                                        </div>
                                        <div class="small">Phí nền tảng: @item.PlatformFee.ToString("N0") đ</div>
                                        <div class="fw-semibold text-end">@item.LineTotal.ToString("N0") đ</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between small mb-1">
                    <span>Tạm tính</span>
                    <span>@Model.Subtotal.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span>Phí nền tảng</span>
                    <span>@Model.PlatformFees.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between fw-bold mb-3">
                    <span>Tổng thanh toán</span>
                    <span class="text-primary">@Model.GrandTotal.ToString("N0") đ</span>
                </div>
                <form method="post" asp-page-handler="Confirm">
                    <button type="submit" class="btn btn-primary w-100" @(Model.LineItems.Any() ? null : "disabled")>
                        Xác nhận đặt hàng
                    </button>
                </form>
                <a asp-page="/Products/Index" class="btn btn-link btn-sm w-100 mt-1">Quay lại cửa hàng</a>
            </div>
        </div>
    </div>
</div>
