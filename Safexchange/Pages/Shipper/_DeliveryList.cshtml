@model IList<Safexchange.Services.IShipmentService.ShipperDeliveryItem>
@using Safexchange.Services

@if (!Model.Any())
{
    <div class="alert alert-info mb-0">Không có đơn trong mục này.</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                            <div>
                                <span class="fw-semibold">Đơn #@item.OrderId</span>
                                <span class="text-muted small">· @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <span class="badge bg-light text-dark border">@ShipmentStatusCodes.ToDisplay(item.ShipmentStatusCode)</span>
                        </div>
                        <p class="mb-1"><strong>@item.ProductTitle</strong></p>
                        <p class="mb-1 small">Khách: @item.BuyerName · @item.ReceiverPhone</p>
                        <p class="mb-2 small text-muted">Giao đến: @item.DeliveryAddress</p>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <span class="fw-bold text-primary">@item.TotalAmount.ToString("N0") đ</span>
                                <span class="small text-muted ms-2">COD</span>
                            </div>
                            <div class="btn-group btn-group-sm">
                                @if (item.CanAccept)
                                {
                                    <button type="button" class="btn btn-outline-primary"
                                            onclick="ShipperDeliveries.accept(@item.ShipmentId)">
                                        Nhận đơn
                                    </button>
                                }
                                @if (item.CanConfirmCod)
                                {
                                    <button type="button" class="btn btn-success"
                                            onclick="ShipperDeliveries.confirmCod(@item.ShipmentId)">
                                        Đã giao &amp; thu tiền
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
