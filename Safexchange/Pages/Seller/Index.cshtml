@page
@model Safexchange.Pages.Seller.IndexModel
@{
    ViewData["Title"] = "Quản lý sản phẩm của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Sản phẩm của tôi</h1>
    @if (Model.IsVerified)
    {
        <a asp-page="/Products/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
        </a>
    }
    else
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#verificationModal">
            <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
        </button>
    }
</div>

<!-- Verification Modal -->
<div class="modal fade" id="verificationModal" tabindex="-1" aria-labelledby="verificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title" id="verificationModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Yêu cầu xác thực tài khoản
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-person-lock display-4 text-warning mb-3"></i>
                <p class="lead mb-0">Tài khoản của bạn cần xác thực để đăng bán sản phẩm.</p>
                <p class="text-muted small mt-2">Vui lòng cung cấp thông tin sinh viên để được duyệt quyền bán hàng.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
                <a asp-page="./VerifyAccount" class="btn btn-primary px-4">Tạo yêu cầu xác thực</a>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <div class="nav nav-pills gap-2">
        <a asp-page="./Index" asp-route-status="" class="nav-link @(string.IsNullOrEmpty(Model.Status) ? "active" : "border")">
            Tất cả
        </a>
        <a asp-page="./Index" asp-route-status="Đang hiển thị" class="nav-link @(Model.Status == "Đang hiển thị" ? "active" : "border")">
            Đang hiển thị
        </a>
        <a asp-page="./Index" asp-route-status="Đã ẩn" class="nav-link @(Model.Status == "Đã ẩn" ? "active" : "border")">
            Đã ẩn
        </a>
        <a asp-page="./Index" asp-route-status="Đã bán" class="nav-link @(Model.Status == "Đã bán" ? "active" : "border")">
            Đã bán
        </a>
    </div>
</div>

@if (!Model.Products.Any())
{
    <div class="card shadow-sm text-center py-5">
        <div class="card-body">
            <div class="mb-3">
                <i class="bi bi-box-seam display-1 text-muted"></i>
            </div>
            <h5>
                @(string.IsNullOrEmpty(Model.Status) ? "Bạn chưa đăng bán sản phẩm nào" : $"Không tìm thấy sản phẩm với trạng thái \"{Model.Status}\"")
            </h5>
            @if (string.IsNullOrEmpty(Model.Status))
            {
                <p class="text-muted">Bắt đầu bán hàng bằng cách thêm sản phẩm đầu tiên của bạn.</p>
                <a asp-page="/Products/Create" class="btn btn-primary">Bán ngay</a>
            }
            else
            {
                <a asp-page="./Index" class="btn btn-outline-primary mt-2">Xem tất cả sản phẩm</a>
            }
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 hover-shadow transition">
                    @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                    {
                        <img src="@product.CoverImageUrl" class="card-img-top" alt="@product.Title" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                            <span>Không có ảnh</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-dark border">@product.CategoryName</span>
                            @{
                                var badgeClass = product.StatusName switch
                                {
                                    "Đang hiển thị" => "bg-success",
                                    "Đã ẩn" => "bg-warning text-dark",
                                    "Đã bán" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@product.StatusName</span>
                        </div>
                        <h5 class="card-title text-truncate">@product.Title</h5>
                        <p class="fw-bold text-primary mb-1">@product.Price.ToString("N0") đ</p>
                        <p class="small text-muted mb-3">Tình trạng: @product.ConditionStatus</p>
                        
                        <div class="mt-auto d-flex gap-2">
                            <a asp-page="/Products/Edit" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm flex-fill rounded-3 transition hover-shadow">
                                <i class="bi bi-pencil"></i> Chỉnh sửa
                            </a>
                            @if (product.StatusName == "Đã bán")
                            {
                                <a asp-page="./OrderDetail" asp-route-productId="@product.ProductId" class="btn btn-primary btn-sm flex-fill rounded-3 transition hover-shadow">
                                    <i class="bi bi-receipt"></i> Đơn hàng
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Products/Detail" asp-route-id="@product.ProductId" class="btn btn-outline-secondary btn-sm flex-fill rounded-3 transition hover-shadow">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    @if (!Model.IsVerified)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var myModal = new bootstrap.Modal(document.getElementById('verificationModal'));
                myModal.show();
            });
        </script>
    }
}
