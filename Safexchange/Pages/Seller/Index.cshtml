@page
@model Safexchange.Pages.Seller.IndexModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="seller-page">

    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="page-title">
                    <i class="bi bi-store me-2"></i>Sản phẩm của tôi
                </h1>
                <p class="page-subtitle">Quản lý và theo dõi các sản phẩm bạn đang bán</p>
            </div>
            <div class="col-md-6 text-md-end">
                @if (Model.IsVerified)
                {
                    <a asp-page="/Products/Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
                    </a>
                }
                else
                {
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#verificationModal">
                        <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
                    </button>
                }
            </div>
        </div>

        <!-- Stats -->
        @if (Model.Products.Any())
        {
            <div class="seller-stats mt-4">
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@Model.Products.Count()</span>
                        <span class="stat-label">Tổng sản phẩm</span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon success">
                        <i class="bi bi-eye"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@Model.Products.Count(p => p.StatusName == "Đang hiển thị")</span>
                        <span class="stat-label">Đang hiển thị</span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon warning">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@Model.Products.Count(p => p.StatusName == "Đã bán")</span>
                        <span class="stat-label">Đã bán</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Verification Modal -->
    <div class="modal fade" id="verificationModal" tabindex="-1" aria-labelledby="verificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header verification-header">
                    <div class="modal-icon">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <h5 class="modal-title" id="verificationModalLabel">Yêu cầu xác thực</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="lead mb-3">Tài khoản của bạn cần được xác thực để có thể đăng bán sản phẩm.</p>
                    <div class="verification-steps">
                        <div class="step">
                            <span class="step-number">1</span>
                            <span>Cung cấp thông tin sinh viên</span>
                        </div>
                        <div class="step">
                            <span class="step-number">2</span>
                            <span>Chờ duyệt trong 24h</span>
                        </div>
                        <div class="step">
                            <span class="step-number">3</span>
                            <span>Bắt đầu đăng bán</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Đóng</button>
                    <a asp-page="./VerifyAccount" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>Xác thực ngay
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        <a asp-page="./Index" asp-route-status="" class="filter-tab @(string.IsNullOrEmpty(Model.Status) ? "active" : "")">
            <i class="bi bi-grid-3x3-gap me-1"></i>Tất cả
        </a>
        <a asp-page="./Index" asp-route-status="Đang hiển thị" class="filter-tab @(Model.Status == "Đang hiển thị" ? "active" : "")">
            <i class="bi bi-eye me-1"></i>Đang hiển thị
        </a>
        <a asp-page="./Index" asp-route-status="Đã ẩn" class="filter-tab @(Model.Status == "Đã ẩn" ? "active" : "")">
            <i class="bi bi-eye-slash me-1"></i>Đã ẩn
        </a>
        <a asp-page="./Index" asp-route-status="Đã bán" class="filter-tab @(Model.Status == "Đã bán" ? "active" : "")">
            <i class="bi bi-bag-check me-1"></i>Đã bán
        </a>
    </div>

    <!-- Products Grid -->
    @if (!Model.Products.Any())
    {
        <div class="empty-state-card">
            <div class="empty-icon">
                <i class="bi bi-shop"></i>
            </div>
            <h4>Bạn chưa có sản phẩm nào</h4>
            <p>Bắt đầu bán hàng bằng cách thêm sản phẩm đầu tiên của bạn</p>
            <a asp-page="/Products/Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Đăng sản phẩm đầu tiên
            </a>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in Model.Products)
            {
                <div class="product-card">
                    <div class="product-image">
                        @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                        {
                            <img src="@product.CoverImageUrl" alt="@product.Title" />
                        }
                        else
                        {
                            <div class="placeholder-image">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                        <span class="product-status @product.StatusName.ToLower().Replace(" ", "-")">
                            @product.StatusName
                        </span>
                    </div>
                    <div class="product-content">
                        <div class="product-meta">
                            <span class="product-category">
                                <i class="bi bi-grid-3x3-gap"></i>@product.CategoryName
                            </span>
                            <span class="product-condition">
                                @product.ConditionStatus
                            </span>
                        </div>
                        <h5 class="product-title">@product.Title</h5>
                        <div class="product-price">
                            <span class="price-value">@product.Price.ToString("N0")</span>
                            <span class="price-currency">đ</span>
                        </div>
                        <div class="product-actions">
                            <a asp-page="/Products/Edit" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (product.StatusName == "Đã bán")
                            {
                                <a asp-page="./OrderDetail" asp-route-productId="@product.ProductId" class="btn btn-success btn-sm flex-fill">
                                    <i class="bi bi-receipt me-1"></i>Đơn hàng
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Products/Detail" asp-route-id="@product.ProductId" class="btn btn-outline-secondary btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i>Xem
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .seller-page {
        padding-bottom: 2rem;
    }

    .page-header {
        background: var(--white);
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.25rem;
    }

    .page-title i {
        color: var(--primary);
    }

    .page-subtitle {
        color: var(--gray-500);
        margin-bottom: 0;
    }

    .seller-stats {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: var(--gray-50);
        border-radius: var(--radius-md);
        flex: 1;
        min-width: 140px;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        background: var(--primary-bg);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-icon i {
        font-size: 1.1rem;
        color: var(--primary);
    }

    .stat-icon.success {
        background: rgba(16, 185, 129, 0.1);
    }

    .stat-icon.success i {
        color: var(--success);
    }

    .stat-icon.warning {
        background: rgba(245, 158, 11, 0.1);
    }

    .stat-icon.warning i {
        color: var(--warning);
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--gray-900);
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--gray-500);
    }

    /* Modal */
    .verification-header {
        background: linear-gradient(135deg, var(--warning), var(--warning-dark));
        color: white;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 600;
    }

    .modal-icon {
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-icon i {
        font-size: 1.25rem;
    }

    .verification-steps {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .verification-steps .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--gray-600);
    }

    .step-number {
        width: 32px;
        height: 32px;
        background: var(--primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .modal-body .lead {
        font-size: 1rem;
        font-weight: 400;
    }

    /* Filter Tabs */
    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-tab {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1rem;
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        color: var(--gray-600);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all var(--transition-base);
    }

    .filter-tab:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-bg);
    }

    .filter-tab.active {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
    }

    /* Products Grid */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .product-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
        overflow: hidden;
        transition: all var(--transition-base);
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .product-image {
        position: relative;
        height: 180px;
        background: var(--gray-100);
    }

    .product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gray-400);
        font-size: 3rem;
    }

    .product-status {
        position: absolute;
        top: 10px;
        right: 10px;
        padding: 0.3rem 0.75rem;
        border-radius: var(--radius-full);
        font-size: 0.7rem;
        font-weight: 600;
    }

    .product-status.đang-hiển-thị {
        background: var(--success);
        color: white;
    }

    .product-status.đã-ẩn {
        background: var(--warning);
        color: #78350f;
    }

    .product-status.đã-bán {
        background: var(--primary);
        color: white;
    }

    .product-content {
        padding: 1rem;
    }

    .product-meta {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .product-category,
    .product-condition {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.75rem;
        padding: 0.2rem 0.5rem;
        background: var(--gray-100);
        border-radius: var(--radius-sm);
        color: var(--gray-600);
    }

    .product-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    .product-price {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
        margin-bottom: 1rem;
    }

    .price-value {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--primary);
    }

    .price-currency {
        font-weight: 600;
        color: var(--primary);
    }

    .product-actions {
        display: flex;
        gap: 0.5rem;
    }

    .product-actions .btn {
        padding: 0.4rem 0.75rem;
    }

    /* Empty State */
    .empty-state-card {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        background: var(--gray-100);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
    }

    .empty-icon i {
        font-size: 2.5rem;
        color: var(--gray-400);
    }

    .empty-state-card h4 {
        color: var(--gray-700);
        margin-bottom: 0.5rem;
    }

    .empty-state-card p {
        color: var(--gray-500);
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .seller-stats {
            flex-direction: column;
        }

        .stat-item {
            min-width: auto;
        }

        .verification-steps {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

@section Scripts {
    @if (!Model.IsVerified)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var myModal = new bootstrap.Modal(document.getElementById('verificationModal'));
                myModal.show();
            });
        </script>
    }
}
