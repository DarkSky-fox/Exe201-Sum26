@page
@model Safexchange.Pages.Seller.VerifyAccountModel
@{
    ViewData["Title"] = "Gửi yêu cầu xác thực";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-badge-fill display-4 text-primary"></i>
                        <h2 class="fw-bold mt-3">Xác thực tài khoản</h2>
                        <p class="text-muted">Cung cấp minh chứng sinh viên để mở khóa tính năng bán hàng.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success rounded-4 d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                            <div>@Model.SuccessMessage</div>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-page="./Index" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-2"></i> Quay lại trang bán hàng
                            </a>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning rounded-4 d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill px-4">
                                Quay lại
                            </a>
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                            
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Loại xác thực</label>
                                <select asp-for="UserVerification.VerificationType" class="form-select form-select-lg rounded-3" required>
                                    <option value="">-- Chọn loại xác thực --</option>
                                    <option value="student_email">Email Sinh viên (với tên miền trường)</option>
                                    <option value="student_card">Thẻ Sinh viên</option>
                                </select>
                                <span asp-validation-for="UserVerification.VerificationType" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Giá trị (Email hoặc MSSV)</label>
                                <input asp-for="UserVerification.VerificationValue" class="form-control form-control-lg rounded-3" placeholder="Ví dụ: sinhvien@fpt.edu.vn hoặc SE123456" required />
                                <span asp-validation-for="UserVerification.VerificationValue" class="text-danger small"></span>
                                <div class="form-text small text-muted">Nhập chính xác Email hoặc Mã số sinh viên của bạn.</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Link ảnh minh chứng (Thẻ SV/Email)</label>
                                <input asp-for="UserVerification.DocumentUrl" class="form-control form-control-lg rounded-3" placeholder="https://..." />
                                <span asp-validation-for="UserVerification.DocumentUrl" class="text-danger small"></span>
                                <div class="form-text small text-muted">Vui lòng tải ảnh lên một dịch vụ lưu trữ (ví dụ: Imgur, Cloudinary) và dán link vào đây.</div>
                            </div>

                            <div class="d-grid gap-2 mt-5">
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                                    Gửi yêu cầu xác thực <i class="bi bi-send-fill ms-2"></i>
                                </button>
                                <a asp-page="./Index" class="btn btn-link link-secondary">Hủy bỏ</a>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <div class="mt-4 text-center">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> 
                    Tại sao tôi cần xác thực? Safexchange yêu cầu xác thực để đảm bảo môi trường mua bán an toàn giữa các sinh viên.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
