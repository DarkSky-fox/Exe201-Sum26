@page
@model Safexchange.Pages.Products.IndexModel
@using Safexchange.Pages.Shared
@{
    ViewData["Title"] = "Sản phẩm";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="products-list-page">

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-title">
                    <i class="bi bi-bag me-2"></i>Danh sách sản phẩm
                </h1>
                <p class="page-subtitle mb-0">Khám phá hàng ngàn sản phẩm từ sinh viên</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    @if (isAuthenticated)
                    {
                        <a asp-page="/Products/Create" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
                        </a>
                    }
                    <button type="button" class="btn btn-outline-primary position-relative" onclick="Cart.openView()">
                        <i class="bi bi-cart3 me-1"></i> Giỏ hàng
                        <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">0</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Section -->
    <div class="search-card mb-4">
        <form method="get" class="mb-0">
            @if (!string.IsNullOrEmpty(Model.SelectedCategory))
            {
                <input type="hidden" name="category" value="@Model.SelectedCategory" />
            }
            <div class="search-box">
                <div class="search-icon">
                    <i class="bi bi-search"></i>
                </div>
                <input type="text"
                       name="search"
                       class="form-control form-control-lg"
                       placeholder="Tìm laptop, bàn, ghế, sách..."
                       value="@Model.Search" />
                <button class="btn btn-primary btn-lg" type="submit">
                    Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    <!-- Categories -->
    @if (Model.Categories.Any())
    {
        <section class="categories-section mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title">
                    <i class="bi bi-grid-3x3-gap me-2"></i>Danh mục
                </h2>
                @if (!string.IsNullOrEmpty(Model.SelectedCategory) || !string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-page="/Products/Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Xóa bộ lọc
                    </a>
                }
            </div>
            <div class="categories-row">
                <a asp-page="/Products/Index"
                   asp-route-search="@Model.Search"
                   class="category-card @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <h6>Tất cả</h6>
                </a>
                @foreach (var cat in Model.Categories)
                {
                    var isActive = Model.SelectedCategory == cat.CategoryName;
                    <a asp-page="/Products/Index"
                       asp-route-category="@cat.CategoryName"
                       asp-route-search="@Model.Search"
                       class="category-card @(isActive ? "active" : "")">
                        <i class="bi @IndexModel.GetCategoryIcon(cat.CategoryName)"></i>
                        <h6>@cat.CategoryName</h6>
                    </a>
                }
            </div>
        </section>
    }

    <!-- Active Filters -->
    @if (!string.IsNullOrEmpty(Model.SelectedCategory) || !string.IsNullOrWhiteSpace(Model.Search))
    {
        <div class="active-filters mb-4">
            <span class="filter-label">
                <i class="bi bi-funnel me-1"></i>Đang lọc:
            </span>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <span class="filter-tag">
                    Từ khóa: @Model.Search
                    <a asp-page="/Products/Index" asp-route-category="@Model.SelectedCategory" class="remove-filter">
                        <i class="bi bi-x"></i>
                    </a>
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.SelectedCategory))
            {
                <span class="filter-tag">
                    @Model.SelectedCategory
                    <a asp-page="/Products/Index" asp-route-search="@Model.Search" class="remove-filter">
                        <i class="bi bi-x"></i>
                    </a>
                </span>
            }
        </div>
    }

    <!-- Products Grid -->
    @if (!Model.Products.Any())
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">
                <i class="bi bi-bag-x"></i>
            </div>
            <h4>Không tìm thấy sản phẩm</h4>
            <p>Hãy thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc</p>
            <a asp-page="/Products/Index" class="btn btn-primary">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Xem tất cả sản phẩm
            </a>
        </div>
    }
    else
    {
        <div class="results-info mb-3">
            <span class="results-count">
                <strong>@Model.Products.Count</strong> sản phẩm được tìm thấy
            </span>
        </div>
        <div class="products-grid">
            @foreach (var product in Model.Products)
            {
                <partial name="Shared/_HomeProductCard"
                         model="HomeProductCardViewModel.FromListItem(
                             product.ProductId,
                             product.Title,
                             product.Price,
                             product.SellerName,
                             product.CategoryName,
                             product.ConditionStatus,
                             product.CoverImageUrl,
                             HomeProductCardVariant.Catalog,
                             isAuthenticated,
                             showCartActions: true,
                             cartIconOnly: true)" />
            }
        </div>
    }
</div>

<style>
    .products-list-page {
        padding: 0 0 2rem;
    }

    .page-header {
        padding: 1.5rem;
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.25rem;
    }

    .page-title i {
        color: var(--primary);
    }

    .page-subtitle {
        color: var(--gray-500);
        font-size: 0.95rem;
    }

    .search-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow-sm);
    }

    .search-box {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        color: var(--gray-400);
        font-size: 1.1rem;
        z-index: 2;
    }

    .search-box .form-control {
        padding-left: 2.75rem;
        border-radius: var(--radius-md);
        flex: 1;
    }

    .search-box .btn {
        border-radius: var(--radius-md);
        padding: 0.625rem 1.5rem;
        white-space: nowrap;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--gray-800);
    }

    .section-title i {
        color: var(--primary);
    }

    /* Categories Row - Single line horizontal scroll */
    .categories-section {
        background: var(--white);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow-xs);
    }

    .categories-row {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        scrollbar-width: thin;
        scrollbar-color: var(--gray-300) transparent;
    }

    .categories-row::-webkit-scrollbar {
        height: 4px;
    }

    .categories-row::-webkit-scrollbar-thumb {
        background: var(--gray-300);
        border-radius: 2px;
    }

    .category-card {
        flex: 1 1 0;
        min-width: 0;
        background: var(--white);
        border-radius: var(--radius-xl);
        padding: 1.25rem 0.5rem;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-100);
        position: relative;
        overflow: hidden;
        text-decoration: none;
    }

    .category-card::before {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--primary), var(--primary-light));
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }

    .category-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-lg);
        border-color: var(--primary);
    }

    .category-card:hover::before,
    .category-card.active::before {
        transform: scaleX(1);
    }

    .category-card.active {
        border-color: var(--primary);
    }

    .category-card:hover i,
    .category-card.active i {
        transform: scale(1.15);
    }

    .category-card i {
        font-size: 2rem;
        color: var(--primary);
        margin-bottom: 0.5rem;
        display: block;
        transition: transform 0.3s ease;
    }

    .category-card h6 {
        font-weight: 600;
        margin: 0;
        color: var(--gray-700);
        font-size: 0.85rem;
        line-height: 1.3;
    }

    .category-card .category-name {
        font-weight: 600;
        margin: 0;
        color: var(--gray-700);
        font-size: 0.85rem;
        line-height: 1.3;
    }

    .active-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: var(--primary-bg);
        border-radius: var(--radius-md);
        border: 1px solid var(--primary-lighter);
    }

    .filter-label {
        color: var(--primary-dark);
        font-weight: 500;
        font-size: 0.9rem;
    }

    .filter-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--white);
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        color: var(--gray-700);
        border: 1px solid var(--gray-200);
    }

    .remove-filter {
        color: var(--gray-400);
        margin-left: 0.25rem;
        text-decoration: none;
        transition: color var(--transition-fast);
    }

    .remove-filter:hover {
        color: var(--danger);
    }

    .empty-state-card {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
    }

    .empty-state-icon {
        width: 100px;
        height: 100px;
        background: var(--gray-100);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
    }

    .empty-state-icon i {
        font-size: 2.5rem;
        color: var(--gray-400);
    }

    .empty-state-card h4 {
        color: var(--gray-700);
        margin-bottom: 0.5rem;
    }

    .empty-state-card p {
        color: var(--gray-500);
        margin-bottom: 1.5rem;
    }

    .results-info {
        padding: 0.5rem 0;
    }

    .results-count {
        color: var(--gray-600);
        font-size: 0.9rem;
    }

    .results-count strong {
        color: var(--primary);
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.25rem;
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .search-box {
            flex-direction: column;
        }

        .search-box .form-control {
            width: 100%;
        }

        .search-box .btn {
            width: 100%;
        }
    }
</style>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script>Cart.refreshBadge();</script>
}
