@page
@model Safexchange.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Danh sách sản phẩm</h1>
    <div class="d-flex gap-2">
        <a asp-page="/Products/Create" class="btn btn-primary">
            Thêm sản phẩm
        </a>
        <button type="button" class="btn btn-outline-primary position-relative" onclick="Cart.openView()">
            Giỏ hàng
            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">0</span>
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="search" class="form-control" placeholder="Tìm theo tên sản phẩm..." value="@Request.Query["search"]" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
    </div>
</form>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">Chưa có sản phẩm nào.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm product-card">
                    @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                    {
                        <div class="product-thumb-frame card-img-top">
                            <img src="@product.CoverImageUrl" class="product-thumb" alt="@product.Title" />
                        </div>
                    }
                    else
                    {
                        <div class="product-thumb-frame product-thumb-frame--empty card-img-top">
                            <span class="text-muted small">Không có ảnh</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Title</h5>
                        <p class="text-muted small mb-1">@product.CategoryName · @product.ConditionStatus</p>
                        <p class="fw-bold text-primary mb-2">@product.Price.ToString("N0") đ</p>
                        <p class="small text-muted mt-auto mb-3">Người bán: @product.SellerName</p>
                        <div class="d-flex gap-2">
                            <a asp-page="/Products/Detail" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm">
                                Xem chi tiết
                            </a>
                            <a asp-page="/Products/Edit" asp-route-id="@product.ProductId" class="btn btn-outline-secondary btn-sm">
                                Sửa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script>Cart.refreshBadge();</script>
}
