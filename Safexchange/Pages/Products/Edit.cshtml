@page
@model Safexchange.Pages.Products.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Chỉnh sửa sản phẩm</h1>
    <a asp-page="/Products/Index" class="btn btn-outline-secondary">
        ← Quay lại danh sách
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Hidden ID -->
                    <input asp-for="Input.ProductId" type="hidden" />

                    <!-- Tiêu đề -->
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label fw-semibold">Tiêu đề sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Nhập tiêu đề sản phẩm..." />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>

                    <!-- Mô tả -->
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label fw-semibold">Mô tả</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>

                    <!-- Giá -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Price" class="form-label fw-semibold">Giá bán (đ) <span class="text-danger">*</span></label>
                            <input asp-for="Input.Price" class="form-control" type="number" min="0" step="1000" />
                            <span asp-validation-for="Input.Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.OriginalPrice" class="form-label fw-semibold">Giá gốc (đ)</label>
                            <input asp-for="Input.OriginalPrice" class="form-control" type="number" min="0" step="1000" placeholder="Không bắt buộc" />
                            <span asp-validation-for="Input.OriginalPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Danh mục & Trạng thái -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CategoryId" class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                            <select asp-for="Input.CategoryId" asp-items="Model.CategoryList" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.StatusId" class="form-label fw-semibold">Trạng thái đăng <span class="text-danger">*</span></label>
                            <select asp-for="Input.StatusId" asp-items="Model.StatusList" class="form-select">
                                <option value="">-- Chọn trạng thái --</option>
                            </select>
                            <span asp-validation-for="Input.StatusId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Tình trạng & Loại sản phẩm -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.ConditionStatus" class="form-label fw-semibold">Tình trạng sản phẩm <span class="text-danger">*</span></label>
                            <select asp-for="Input.ConditionStatus" class="form-select">
                                <option value="like_new">Như mới</option>
                                <option value="good">Tốt</option>
                                <option value="fair">Khá tốt</option>
                                <option value="need_repair">Cần sửa chữa</option>
                            </select>
                            <span asp-validation-for="Input.ConditionStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ProductType" class="form-label fw-semibold">Loại sản phẩm <span class="text-danger">*</span></label>
                            <select asp-for="Input.ProductType" class="form-select">
                                <option value="single">Đơn lẻ</option>
                                <option value="combo">Combo</option>
                            </select>
                            <span asp-validation-for="Input.ProductType" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Ảnh sản phẩm -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ảnh sản phẩm</label>

                        <div class="product-edit-images product-edit-images--dual mb-3" id="imageCompareSection">
                            @if (!string.IsNullOrEmpty(Model.CurrentCoverImageUrl))
                            {
                                <div id="currentImageSection">
                                    <span class="small text-muted d-block mb-1">Ảnh hiện tại</span>
                                    <div class="image-preview-wrap">
                                        <img src="@Model.CurrentCoverImageUrl" alt="Ảnh hiện tại" class="image-preview" id="currentCoverImage" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0" id="noImageHint">Sản phẩm chưa có ảnh.</p>
                            }

                            <div id="newImagePreviewWrap" class="d-none">
                                <span class="small text-muted d-block mb-1">Ảnh mới (xem trước)</span>
                                <div class="image-preview-wrap">
                                    <img id="newImagePreview" src="" alt="Ảnh mới" class="image-preview" />
                                </div>
                            </div>
                        </div>

                        <label asp-for="CoverImage" class="form-label fw-semibold">@(string.IsNullOrEmpty(Model.CurrentCoverImageUrl) ? "Chọn ảnh" : "Thay ảnh mới")</label>
                        <input asp-for="CoverImage" type="file" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp" id="coverImageInput" />
                        <div class="form-text">JPG, PNG, GIF hoặc WEBP — tối đa 5MB. Để trống nếu giữ ảnh hiện tại.</div>
                        <span asp-validation-for="CoverImage" class="text-danger small"></span>

                        @if (!string.IsNullOrEmpty(Model.CurrentCoverImageUrl))
                        {
                            <div class="form-check mt-3" id="removeImageCheckWrap">
                                <input asp-for="RemoveCoverImage" class="form-check-input" type="checkbox" id="removeCoverImage" />
                                <label asp-for="RemoveCoverImage" class="form-check-label">Xóa ảnh hiện tại</label>
                            </div>
                        }
                    </div>

                    <!-- Thương lượng -->
                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Input.IsNegotiable" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.IsNegotiable" class="form-check-label">Cho phép thương lượng giá</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            💾 Lưu thay đổi
                        </button>
                        <a asp-page="/Products/Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const coverInput = document.getElementById('coverImageInput');
        const newPreviewWrap = document.getElementById('newImagePreviewWrap');
        const newPreviewImg = document.getElementById('newImagePreview');
        const removeCheckbox = document.getElementById('removeCoverImage');

        coverInput?.addEventListener('change', function (e) {
            const file = e.target.files?.[0];
            if (!file || !newPreviewWrap || !newPreviewImg) return;

            newPreviewImg.src = URL.createObjectURL(file);
            newPreviewWrap.classList.remove('d-none');

            if (removeCheckbox) {
                removeCheckbox.checked = false;
            }
        });

        removeCheckbox?.addEventListener('change', function () {
            if (this.checked && coverInput) {
                coverInput.value = '';
            }
            if (this.checked && newPreviewWrap) {
                newPreviewWrap.classList.add('d-none');
            }
        });
    </script>
}
