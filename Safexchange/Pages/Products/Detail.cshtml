@page "{id:int}"
@model Safexchange.Pages.Products.DetailModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Model.Product?.Title ?? "Chi tiết sản phẩm";
    var p = Model.Product!;
    var requestToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}
<input type="hidden" name="__RequestVerificationToken" value="@requestToken" />

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="breadcrumb-nav mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-page="/Products/Index">
                <i class="bi bi-house me-1"></i>Trang chủ
            </a>
        </li>
        <li class="breadcrumb-item">
            <a asp-page="/Products/Index">Sản phẩm</a>
        </li>
        <li class="breadcrumb-item active">@p.Title</li>
    </ol>
</nav>

<!-- Product Detail -->
<div class="product-detail-page">
    <div class="row g-4">
        <!-- Product Images -->
        <div class="col-lg-5">
            <div class="product-gallery">
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <div class="main-image">
                        <img src="@Model.CoverImageUrl" 
                             class="img-fluid rounded-3" 
                             alt="@p.Title"
                             id="mainProductImage" />
                    </div>
                }
                else
                {
                    <div class="main-image placeholder">
                        <div class="placeholder-content">
                            <i class="bi bi-image"></i>
                            <span>Không có ảnh</span>
                        </div>
                    </div>
                }
                
                <!-- Share & Actions -->
                <div class="product-actions-bar mt-3">
                    <button class="action-btn" onclick="shareProduct()">
                        <i class="bi bi-share"></i>
                        <span>Chia sẻ</span>
                    </button>
                    <button class="action-btn" onclick="saveProduct()">
                        <i class="bi bi-bookmark"></i>
                        <span>Lưu</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-lg-7">
            <div class="product-info-card">
                <!-- Header -->
                <div class="product-header">
                    <div class="product-meta">
                        <span class="meta-tag category-tag">
                            <i class="bi bi-grid-3x3-gap me-1"></i>@p.Category.CategoryName
                        </span>
                        <span class="meta-tag condition-tag">
                            <i class="bi bi-check-circle me-1"></i>@p.ConditionStatus
                        </span>
                        <span class="meta-tag status-tag @(p.Status.StatusName == "Đang bán" ? "active" : "inactive")">
                            @p.Status.StatusName
                        </span>
                    </div>
                    <h1 class="product-title">@p.Title</h1>
                    <div class="product-stats">
                        <span class="stat-item">
                            <i class="bi bi-eye"></i>
                            @p.ViewCount lượt xem
                        </span>
                        <span class="stat-item">
                            <i class="bi bi-clock"></i>
                            @p.CreatedAt.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                </div>

                <!-- Price -->
                <div class="product-price-section">
                    <div class="current-price">
                        <span class="price-value">@p.Price.ToString("N0")</span>
                        <span class="price-currency">đ</span>
                    </div>
                    @if (p.OriginalPrice.HasValue && p.OriginalPrice > p.Price)
                    {
                        <div class="price-info">
                            <span class="original-price">
                                <del>@p.OriginalPrice.Value.ToString("N0") đ</del>
                            </span>
                            <span class="discount-badge">
                                -@((100 - (p.Price * 100 / p.OriginalPrice.Value)).ToString("N0"))%
                            </span>
                        </div>
                    }
                </div>

                <!-- Seller Info -->
                <div class="seller-card">
                    <div class="seller-avatar">
                        @p.Seller.FullName.Substring(0, 1)
                    </div>
                    <div class="seller-info">
                        <h5 class="seller-name">@p.Seller.FullName</h5>
                    </div>
                    <a href="/Chat?userId=@p.SellerId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-chat me-1"></i>Nhắn tin
                    </a>
                </div>

                <!-- Purchase Actions -->
                @if (!Model.IsAvailableForPurchase)
                {
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Sản phẩm này đã bán hoặc ngừng hiển thị. Bạn không thể đặt mua thêm.
                    </div>
                }
                else
                {
                    <div class="purchase-actions">
                        <button type="button" class="btn btn-primary btn-lg" onclick="ProductActions.buyNow(@p.ProductId)">
                            <i class="bi bi-lightning-charge me-2"></i>Mua ngay
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-lg" onclick="ProductActions.addToCart(@p.ProductId)">
                            <i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ
                        </button>
                    </div>
                }

                <button type="button" class="btn btn-outline-secondary w-100 mt-3" onclick="Cart.openView()">
                    <i class="bi bi-cart3 me-2"></i>Xem giỏ hàng
                </button>

                <!-- Escrow Info -->
                <div class="escrow-info">
                    <div class="escrow-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="escrow-text">
                        <h6>Mua hàng an toàn với Escrow</h6>
                        <p>Tiền của bạn được giữ an toàn cho đến khi nhận được hàng đúng với mô tả.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Description & Details -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="detail-tabs">
                <ul class="nav nav-pills mb-3" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="desc-tab" data-bs-toggle="pill" data-bs-target="#desc" type="button">
                            <i class="bi bi-card-text me-1"></i>Mô tả
                        </button>
                    </li>
                    @if (p.Combos.Any())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="combo-tab" data-bs-toggle="pill" data-bs-target="#combo" type="button">
                                <i class="bi bi-box-seam me-1"></i>Combo
                            </button>
                        </li>
                    }
                </ul>
                
                <div class="tab-content" id="productTabContent">
                    <div class="tab-pane fade show active" id="desc">
                        <div class="description-content">
                            @if (string.IsNullOrWhiteSpace(p.Description))
                            {
                                <p class="text-muted">Chưa có mô tả cho sản phẩm này.</p>
                            }
                            else
                            {
                                <p>@p.Description</p>
                            }
                        </div>
                    </div>
                    @if (p.Combos.Any())
                    {
                        <div class="tab-pane fade" id="combo">
                            <div class="combo-list">
                                @foreach (var combo in p.Combos)
                                {
                                    <div class="combo-item">
                                        <div class="combo-icon">
                                            <i class="bi bi-check-circle"></i>
                                        </div>
                                        <div class="combo-details">
                                            <h6>@combo.ItemName <span class="combo-qty">x@combo.Quantity</span></h6>
                                            @if (combo.EstimatedValue.HasValue)
                                            {
                                                <span class="combo-value">
                                                    Giá trị: @combo.EstimatedValue.Value.ToString("N0") đ
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="product-toast" class="toast align-items-center text-bg-success border-0 position-fixed bottom-0 end-0 m-3" role="alert">
    <div class="d-flex">
        <div class="toast-body" id="product-toast-body"></div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
</div>

<style>
    .product-detail-page {
        padding-bottom: 2rem;
    }

    .breadcrumb-nav {
        background: var(--white);
        padding: 0.75rem 1rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--gray-200);
    }

    .breadcrumb {
        margin-bottom: 0;
        background: transparent;
    }

    .breadcrumb-item a {
        color: var(--gray-600);
        text-decoration: none;
    }

    .breadcrumb-item a:hover {
        color: var(--primary);
    }

    .breadcrumb-item.active {
        color: var(--gray-900);
    }

    .product-gallery {
        position: sticky;
        top: 80px;
    }

    .main-image {
        position: relative;
        background: var(--gray-100);
        border-radius: var(--radius-lg);
        overflow: hidden;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .main-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .main-image.placeholder {
        background: linear-gradient(135deg, var(--gray-100), var(--gray-200));
    }

    .placeholder-content {
        text-align: center;
        color: var(--gray-400);
    }

    .placeholder-content i {
        font-size: 4rem;
        margin-bottom: 0.5rem;
    }

    .vip-badge,
    .featured-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 0.4rem 0.85rem;
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 600;
        z-index: 2;
    }

    .vip-badge {
        background: linear-gradient(135deg, #fde047, #f59e0b);
        color: #78350f;
    }

    .featured-badge {
        background: var(--primary);
        color: white;
        left: auto;
        right: 12px;
    }

    .product-actions-bar {
        display: flex;
        gap: 0.75rem;
    }

    .action-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.65rem;
        background: var(--gray-100);
        border: none;
        border-radius: var(--radius-md);
        color: var(--gray-600);
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--transition-base);
    }

    .action-btn:hover {
        background: var(--primary-bg);
        color: var(--primary);
    }

    .product-info-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
        padding: 1.5rem;
    }

    .product-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .meta-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.75rem;
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 500;
        background: var(--gray-100);
        color: var(--gray-600);
    }

    .meta-tag.category-tag {
        background: var(--primary-bg);
        color: var(--primary-dark);
    }

    .status-tag.active {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
    }

    .status-tag.inactive {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
    }

    .product-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .product-stats {
        display: flex;
        gap: 1.5rem;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--gray-500);
        font-size: 0.85rem;
    }

    .product-price-section {
        margin: 1.5rem 0;
        padding: 1.25rem;
        background: var(--gray-50);
        border-radius: var(--radius-md);
    }

    .current-price {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
    }

    .price-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
    }

    .price-currency {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--primary);
    }

    .price-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .original-price {
        color: var(--gray-400);
        font-size: 0.95rem;
    }

    .discount-badge {
        background: var(--danger);
        color: white;
        padding: 0.2rem 0.5rem;
        border-radius: var(--radius-sm);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .negotiable-tag {
        display: inline-flex;
        align-items: center;
        margin-top: 0.5rem;
        padding: 0.3rem 0.75rem;
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning-dark);
        border-radius: var(--radius-full);
        font-size: 0.8rem;
        font-weight: 500;
    }

    .seller-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--gray-50);
        border-radius: var(--radius-md);
        margin-bottom: 1.5rem;
    }

    .seller-avatar {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .seller-info {
        flex: 1;
    }

    .seller-name {
        font-size: 1rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.25rem;
    }

    .verified-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 500;
    }

    .purchase-actions {
        display: flex;
        gap: 0.75rem;
    }

    .purchase-actions .btn {
        flex: 1;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        border-radius: var(--radius-md);
    }

    .escrow-info {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        padding: 1rem;
        background: rgba(16, 185, 129, 0.05);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: var(--radius-md);
    }

    .escrow-icon {
        width: 48px;
        height: 48px;
        background: var(--success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .escrow-icon i {
        font-size: 1.25rem;
        color: white;
    }

    .escrow-text h6 {
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.25rem;
    }

    .escrow-text p {
        color: var(--gray-600);
        font-size: 0.85rem;
        margin-bottom: 0;
        line-height: 1.5;
    }

    .detail-tabs {
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
        padding: 1.25rem;
    }

    .nav-pills .nav-link {
        color: var(--gray-600);
        font-weight: 500;
        padding: 0.65rem 1.25rem;
        border-radius: var(--radius-md);
    }

    .nav-pills .nav-link.active {
        background: var(--primary);
        color: white;
    }

    .description-content {
        padding: 1rem 0;
        color: var(--gray-700);
        line-height: 1.7;
    }

    .combo-list {
        padding: 1rem 0;
    }

    .combo-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem;
        background: var(--gray-50);
        border-radius: var(--radius-md);
        margin-bottom: 0.5rem;
    }

    .combo-item:last-child {
        margin-bottom: 0;
    }

    .combo-icon {
        width: 36px;
        height: 36px;
        background: var(--success);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .combo-details h6 {
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.1rem;
    }

    .combo-qty {
        color: var(--gray-500);
        font-weight: 400;
    }

    .combo-value {
        font-size: 0.85rem;
        color: var(--gray-500);
    }

    @@media (max-width: 768px) {
        .product-gallery {
            position: static;
        }

        .purchase-actions {
            flex-direction: column;
        }

        .product-actions-bar {
            flex-wrap: wrap;
        }
    }
</style>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/product-actions.js" asp-append-version="true"></script>
    <script>
        Cart.refreshBadge();
        function shareProduct() {
            if (navigator.share) {
                navigator.share({
                    title: '@p.Title',
                    text: 'Xem sản phẩm này trên Safexchange',
                    url: window.location.href
                });
            } else {
                navigator.clipboard.writeText(window.location.href);
                alert('Đã sao chép link!');
            }
        }
        function saveProduct() {
            alert('Đã lưu sản phẩm!');
        }
    </script>
}
