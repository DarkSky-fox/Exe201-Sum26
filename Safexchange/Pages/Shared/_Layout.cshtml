<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Safexchange</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4LCPZMN0XX"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-4LCPZMN0XX');
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Safexchange.styles.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.14/dist/browser/signalr.min.js"></script>
</head>
<body class="@(ViewData["FullWidth"] as bool? == true ? "layout-fullwidth" : "") layout-with-sidebar">
    <!-- TOP NAVBAR - Chỉ giữ lại các mục thiết yếu -->
    <header class="top-navbar">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center justify-content-between w-100">
                <!-- Logo & Toggle -->
                <div class="d-flex align-items-center gap-3">
                    <button class="sidebar-toggle-btn d-lg-none" type="button" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>
                    <a class="navbar-brand fw-bold text-primary" asp-area="" asp-page="/Index">
                        <i class="bi bi-shop me-1"></i>Safexchange
                    </a>
                </div>

                <!-- Search Bar (mới) -->
                <div class="search-bar-wrapper d-none d-md-flex flex-grow-1 mx-4">
                    <form class="w-100" method="get" asp-page="/Products/Index">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" placeholder="Tìm kiếm sản phẩm..." />
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Right Actions -->
                <div class="d-flex align-items-center gap-2">
                    <!-- CART -->
                    <button type="button"
                            class="btn btn-outline-primary btn-sm position-relative"
                            onclick="Cart.openView()">
                        <i class="bi bi-cart3"></i>
                        <span id="cart-badge"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                              style="display:none;">
                            0
                        </span>
                    </button>

                    <!-- NOTIFICATIONS -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm position-relative"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                onclick="Notifications.loadDropdown()">
                            <i class="bi bi-bell"></i>
                            <span id="notification-badge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="display:none;">
                                0
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-dropdown" style="width: 360px;">
                            <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Thông báo</h6>
                                <a href="/Notifications/Index" class="small text-decoration-none">Xem tất cả</a>
                            </div>
                            <div id="notification-list" class="notification-list">
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-bell-slash fs-4"></i>
                                    <p class="mb-0 small">Không có thông báo nào</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MESSAGES / CHAT -->
                    <a href="/Chat/Index" class="btn btn-outline-info btn-sm position-relative">
                        <i class="bi bi-chat-dots"></i>
                        <span id="chat-badge"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info"
                              style="display:none;">
                            0
                        </span>
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- USER MENU -->
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-md-inline">@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                                <li><a class="dropdown-item" href="/Orders/Index"><i class="bi bi-receipt me-2"></i>Đơn hàng</a></li>
                                <li><a class="dropdown-item" href="/Favourites"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a href="/Logout" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Login" class="btn btn-primary btn-sm">Đăng nhập</a>
                        <a href="/Register" class="btn btn-outline-success btn-sm">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h5 class="mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Menu</h5>
            <button class="sidebar-close-btn d-lg-none" type="button" onclick="toggleSidebar()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <div class="sidebar-section">
                <a class="sidebar-link @(Context.Request.Path == "/" ? "active" : "")" asp-area="" asp-page="/Index">
                    <i class="bi bi-house"></i>
                    <span>Trang chủ</span>
                </a>
                <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Products") ? "active" : "")" asp-area="" asp-page="/Products/Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Tài khoản</h6>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Seller") ? "active" : "")" asp-area="" asp-page="/Seller/Index">
                        <i class="bi bi-shop-window"></i>
                        <span>Sản phẩm của bạn</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Orders") ? "active" : "")" asp-area="" asp-page="/Orders/Index">
                        <i class="bi bi-bag-check"></i>
                        <span>Lịch sử mua hàng</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Chat") ? "active" : "")" asp-area="" asp-page="/Chat/Index">
                        <i class="bi bi-chat-dots"></i>
                        <span>Tin nhắn</span>
                        <span id="sidebar-chat-badge" class="badge bg-info ms-auto" style="display:none;">0</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Notifications") ? "active" : "")" asp-area="" asp-page="/Notifications/Index">
                        <i class="bi bi-bell"></i>
                        <span>Thông báo</span>
                        <span id="sidebar-notif-badge" class="badge bg-danger ms-auto" style="display:none;">0</span>
                    </a>
                </div>
            }

            @if (User.IsInRole("shipper"))
            {
                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Shipper</h6>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Shipper") ? "active" : "")" asp-area="" asp-page="/Shipper/Index">
                        <i class="bi bi-truck"></i>
                        <span>Giao hàng</span>
                    </a>
                </div>
            }

            @if (User.IsInRole("admin"))
            {
                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Quản trị</h6>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Dashboard") ? "active" : "")" asp-area="" asp-page="/Admin/Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Users") ? "active" : "")" asp-area="" asp-page="/Admin/UserManagement/Index">
                        <i class="bi bi-people"></i>
                        <span>Người dùng</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Reports") ? "active" : "")" asp-area="" asp-page="/Admin/Reports">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>Báo cáo</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Settings") ? "active" : "")" asp-area="" asp-page="/Admin/Settings">
                        <i class="bi bi-gear"></i>
                        <span>Cài đặt</span>
                    </a>
                </div>
            }
        </nav>
    </aside>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- MAIN CONTENT -->
    <main class="main-content" id="main-content">
        @if (ViewData["FullWidth"] as bool? == true)
        {
            <div class="page-main pb-4">
                @RenderBody()
            </div>
        }
        else
        {
            <div class="page-main container pb-4">
                @RenderBody()
            </div>
        }
    </main>

    <!-- Main Footer -->
    <footer class="main-footer py-5">
        <div class="container">
            <div class="row g-4">
                <!-- Company Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-3">
                        <h5 class="footer-logo">
                            <i class="bi bi-shop me-2"></i>Safexchange
                        </h5>
                    </div>
                    <p class="footer-desc">
                        Nền tảng mua bán trực tuyến dành cho sinh viên với hệ thống Escrow bảo vệ an toàn cho cả người mua và người bán.
                    </p>
                    <div class="footer-social mt-3">
                        <a href="#" class="footer-social-link"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-social-link"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="footer-social-link"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="footer-social-link"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">Về chúng tôi</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/About">Giới thiệu</a></li>
                        <li><a asp-page="/Contact">Liên hệ</a></li>
                        <li><a asp-page="/About">Tuyển dụng</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>

                <!-- Support -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">Hỗ trợ</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/Contact">Trung tâm hỗ trợ</a></li>
                        <li><a href="#">Hướng dẫn sử dụng</a></li>
                        <li><a href="#">Câu hỏi thường gặp</a></li>
                        <li><a asp-page="/Terms">Chính sách giải quyết tranh chấp</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">Pháp lý</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/Terms">Điều khoản sử dụng</a></li>
                        <li><a asp-page="/Privacy">Chính sách quyền riêng tư</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Chính sách hoàn tiền</a></li>
                    </ul>
                </div>

                <!-- Contact Info -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">Liên hệ</h6>
                    <div class="footer-contact">
                        <p><i class="bi bi-geo-alt me-2"></i>TP. Hồ Chí Minh</p>
                        <p><i class="bi bi-envelope me-2"></i>support@safexchange.edu.vn</p>
                        <p><i class="bi bi-telephone me-2"></i>0123-456-789</p>
                        <p><i class="bi bi-clock me-2"></i>8:00 - 17:00 (T2-T6)</p>
                    </div>
                </div>
            </div>

            <!-- Payment & Certifications -->
            <div class="footer-payments mt-4 pt-4 border-top border-secondary">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p class="mb-2 mb-md-0 text-white-50">Phương thức thanh toán</p>
                        <div class="payment-icons">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Visa_Inc._logo.svg/100px-Visa_Inc._logo.svg.png" alt="Visa" height="24">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2a/Mastercard-logo.svg/100px-Mastercard-logo.svg.png" alt="Mastercard" height="24">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/ZaloPay_Logo.svg/100px-ZaloPay_Logo.svg.png" alt="ZaloPay" height="24">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/46/Vnpay_logo.svg/100px-Vnpay_logo.svg.png" alt="VNPay" height="24">
                            <span class="payment-cod">
                                <i class="bi bi-cash-coin"></i>
                                <span>COD</span>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <div class="certification-badges">
                            <span class="cert-badge">
                                <i class="bi bi-shield-check"></i>
                                SSL Bảo mật
                            </span>
                            <span class="cert-badge">
                                <i class="bi bi-patch-check"></i>
                                Đã xác thực
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bottom Footer -->
    <footer class="footer-bottom py-3">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0">&copy; 2026 Safexchange. Tất cả quyền được bảo lưu.</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a href="#" class="me-3"><i class="bi bi-facebook me-1"></i>Facebook</a>
                    <a href="#" class="me-3"><i class="bi bi-instagram me-1"></i>Instagram</a>
                    <span class="text-muted">Sinh viên Việt Nam</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>

    @await Html.PartialAsync("_CartModals")

    @await RenderSectionAsync("Scripts", required: false)
    <script>document.addEventListener('DOMContentLoaded', function () { 
        Cart.refreshBadge(); 
        Notifications.init();
        Chat.init();
    });</script>
</body>
</html>