@page
@model Safexchange.Pages.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="left-side">

            <div class="overlay"></div>

            <div class="content">

                <h1>Safexchange</h1>

                <p>
                    Student Second-Hand Marketplace
                </p>

                <ul>
                    <li>Buy affordable products</li>
                    <li>Sell unused items quickly</li>
                    <li>Trusted student community</li>
                </ul>

            </div>

        </div>

        <div class="right-side">

            <div class="form-container">

                <h2>Welcome Back</h2>

                <p class="subtitle">
                    Login to continue
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="input-group">

                        <label asp-for="Input.Email">Email</label>

                        <input asp-for="Input.Email"
                               class="custom-input"
                               placeholder="Enter your email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>

                    </div>

                    <div class="input-group">

                        <label asp-for="Input.Password">Password</label>

                        <input asp-for="Input.Password"
                               type="password"
                               class="custom-input"
                               placeholder="Enter your password" />

                    </div>

                    <button type="submit"
                            class="login-btn">

                        Login

                    </button>

                </form>

                <div class="divider">
                    OR
                </div>

                <a asp-page="/GoogleLogin"
                   class="google-btn">

                    <img src="https://cdn-icons-png.flaticon.com/512/2991/2991148.png"
                         width="20" />

                    Continue with Google

                </a>

                <div class="register-link">

                    Don't have an account?

                    <a asp-page="/Register">
                        Register
                    </a>

                </div>

                <p class="text-danger">
                    @Model.Message
                </p>

            </div>

        </div>

    </div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 100%);
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
    }

    .login-card {
        width: min(1000px, 100%);
        min-height: 650px;
        background: white;
        border-radius: 28px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.12);
    }

    .left-side {
        width: 50%;
        background: linear-gradient(rgba(17,24,39,0.55), rgba(17,24,39,0.55)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f');
        background-size: cover;
        background-position: center;
        position: relative;
        color: white;
        display: flex;
        align-items: flex-end;
    }

    .content {
        padding: 44px;
        z-index: 2;
        max-width: 420px;
    }

        .content h1 {
            font-size: 48px;
            margin: 0 0 12px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .content p {
            font-size: 18px;
            margin: 0 0 24px;
            line-height: 1.5;
            opacity: 0.95;
        }

        .content ul {
            padding-left: 18px;
            margin: 0;
        }

        .content li {
            margin-bottom: 12px;
            font-size: 16px;
            line-height: 1.45;
        }

    .right-side {
        width: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: white;
        padding: 32px;
    }

    .form-container {
        width: min(420px, 100%);
    }

        .form-container h2 {
            font-size: 34px;
            margin: 0 0 8px;
            color: #111827;
            letter-spacing: -0.02em;
        }

    .subtitle {
        color: #6b7280;
        margin-bottom: 28px;
        font-size: 15px;
    }

    .input-group {
        margin-bottom: 18px;
    }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #374151;
            font-size: 14px;
        }

    .custom-input {
        width: 100%;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #d1d5db;
        font-size: 16px;
        background: #fff;
        transition: 0.2s ease;
    }

        .custom-input:focus {
            border-color: #4f46e5;
            outline: none;
            box-shadow: 0 0 0 4px rgba(79,70,229,0.12);
        }

    .login-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 24px rgba(79, 70, 229, 0.22);
    }

        .login-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(79, 70, 229, 0.28);
        }

    .divider {
        text-align: center;
        margin: 22px 0;
        color: #9ca3af;
        position: relative;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.08em;
    }

        .divider::before,
        .divider::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 38%;
            height: 1px;
            background: #e5e7eb;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

    .google-btn {
        width: 100%;
        padding: 13px 14px;
        border-radius: 14px;
        border: 1px solid #d1d5db;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #111827;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .google-btn:hover {
            background: #f9fafb;
            border-color: #cbd5e1;
        }

    .register-link {
        text-align: center;
        margin-top: 22px;
        color: #6b7280;
        font-size: 14px;
    }

        .register-link a {
            text-decoration: none;
            color: #4f46e5;
            font-weight: 700;
        }

    .text-danger {
        margin-top: 16px;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .login-page {
            padding: 14px;
            align-items: stretch;
        }

        .login-card {
            flex-direction: column;
            min-height: auto;
            border-radius: 24px;
        }

        .left-side {
            width: 100%;
            min-height: 220px;
            align-items: flex-end;
        }

        .content {
            padding: 28px 24px;
            max-width: 100%;
        }

            .content h1 {
                font-size: 34px;
            }

            .content p {
                font-size: 15px;
                margin-bottom: 16px;
            }

            .content li {
                font-size: 14px;
            }

        .right-side {
            width: 100%;
            padding: 24px 18px 30px;
        }

        .form-container h2 {
            font-size: 28px;
        }
    }

    @@media (max-width: 480px) {
        .login-page {
            padding: 10px;
        }

        .login-card {
            border-radius: 20px;
        }

        .left-side {
            min-height: 180px;
        }

        .content {
            padding: 22px 18px;
        }

            .content h1 {
                font-size: 28px;
            }

        .right-side {
            padding: 20px 16px 24px;
        }

        .form-container h2 {
            font-size: 24px;
        }

        .subtitle {
            margin-bottom: 22px;
        }

        .custom-input,
        .login-btn,
        .google-btn {
            border-radius: 12px;
        }

        .divider::before,
        .divider::after {
            width: 34%;
        }
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}