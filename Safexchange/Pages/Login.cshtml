@page
@model Safexchange.Pages.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="left-side">

            <div class="overlay"></div>

            <div class="content">

                <h1>Safexchange</h1>

                <p>
                    Student Second-Hand Marketplace
                </p>

                <ul>
                    <li>Buy affordable products</li>
                    <li>Sell unused items quickly</li>
                    <li>Trusted student community</li>
                </ul>

            </div>

        </div>

        <div class="right-side">

            <div class="form-container">

                <h2>Welcome Back</h2>

                <p class="subtitle">
                    Login to continue
                </p>

                <form method="post">

                    <div class="input-group">

                        <label>Email</label>

                        <input asp-for="Email"
                               class="custom-input"
                               placeholder="Enter your email" />

                    </div>

                    <div class="input-group">

                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               class="custom-input"
                               placeholder="Enter your password" />

                    </div>

                    <button type="submit"
                            class="login-btn">

                        Login

                    </button>

                </form>

                <div class="divider">
                    OR
                </div>

                <a asp-page="/GoogleLogin"
                   class="google-btn">

                    <img src="https://cdn-icons-png.flaticon.com/512/2991/2991148.png"
                         width="20" />

                    Continue with Google

                </a>

                <div class="register-link">

                    Don't have an account?

                    <a asp-page="/Register">
                        Register
                    </a>

                </div>

                <p class="text-danger">
                    @Model.Message
                </p>

            </div>

        </div>

    </div>

</div>

<style>

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #f4f7fb;
    }

    .login-page {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .login-card {
        width: 1000px;
        height: 650px;
        background: white;
        border-radius: 30px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }

    .left-side {
        width: 50%;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f');
        background-size: cover;
        background-position: center;
        position: relative;
        color: white;
        display: flex;
        align-items: center;
    }

    .content {
        padding: 50px;
        z-index: 2;
    }

        .content h1 {
            font-size: 48px;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .content p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .content ul {
            padding-left: 20px;
        }

        .content li {
            margin-bottom: 12px;
            font-size: 16px;
        }

    .right-side {
        width: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: white;
    }

    .form-container {
        width: 80%;
    }

        .form-container h2 {
            font-size: 36px;
            margin-bottom: 10px;
            color: #222;
        }

    .subtitle {
        color: gray;
        margin-bottom: 30px;
    }

    .input-group {
        margin-bottom: 20px;
    }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

    .custom-input {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid #ddd;
        font-size: 15px;
        transition: 0.3s;
    }

        .custom-input:focus {
            border-color: #4f46e5;
            outline: none;
            box-shadow: 0 0 10px rgba(79,70,229,0.2);
        }

    .login-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        background: #4f46e5;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

        .login-btn:hover {
            background: #4338ca;
        }

    .divider {
        text-align: center;
        margin: 25px 0;
        color: gray;
        position: relative;
    }

        .divider::before,
        .divider::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 40%;
            height: 1px;
            background: #ddd;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

    .google-btn {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid #ddd;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #333;
        font-weight: 600;
        transition: 0.3s;
    }

        .google-btn:hover {
            background: #f5f5f5;
        }

    .register-link {
        text-align: center;
        margin-top: 25px;
    }

        .register-link a {
            text-decoration: none;
            color: #4f46e5;
            font-weight: bold;
        }

    .text-danger {
        margin-top: 20px;
        text-align: center;
    }

</style>