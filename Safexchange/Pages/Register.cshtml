@page
@model Safexchange.Pages.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-page">

    <div class="register-card">

        <!-- LEFT SIDE -->
        <div class="left-side">

            <div class="content">

                <h1>Join Safexchange</h1>

                <p>
                    Buy & Sell Second-Hand Items For Students
                </p>

                <div class="features">

                    <div class="feature-box">
                        Affordable Student Prices
                    </div>

                    <div class="feature-box">
                        Trusted University Community
                    </div>

                    <div class="feature-box">
                        Fast & Easy Marketplace
                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="right-side">

            <div class="form-container">

                <h2>Create Account</h2>

                <p class="subtitle">
                    Start your student marketplace journey
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="input-group">
                        <label asp-for="Input.FullName">Full Name</label>

                        <input asp-for="Input.FullName"
                               class="custom-input"
                               placeholder="Enter your full name" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="input-group">
                        <label asp-for="Input.Email">Email</label>

                        <input asp-for="Input.Email"
                               class="custom-input"
                               placeholder="Enter your email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="input-group">
                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               class="custom-input"
                               placeholder="Enter password" />
                    </div>

                    <div class="input-group">
                        <label asp-for="Input.Phone">Phone</label>

                        <input asp-for="Input.Phone"
                               class="custom-input"
                               placeholder="0912345678"
                               inputmode="tel"
                               autocomplete="tel" />
                        <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                    </div>

                    <div class="input-group">

                        <label asp-for="Input.YearLevel">Year Level</label>

                        <select asp-for="Input.YearLevel"
                                class="custom-input">

                            <option value="">Select Year</option>
                            <option value="year1">Year 1</option>
                            <option value="year2">Year 2</option>
                            <option value="year3">Year 3</option>
                            <option value="year4">Year 4</option>
                            <option value="graduated">Graduated</option>

                        </select>
                        <span asp-validation-for="Input.YearLevel" class="text-danger small"></span>

                    </div>

                    <button type="submit"
                            class="register-btn">

                        Create Account

                    </button>

                </form>

                <div class="divider">
                    OR
                </div>

                <a asp-page="/GoogleLogin"
                   class="google-btn">

                    <img src="https://cdn-icons-png.flaticon.com/512/2991/2991148.png"
                         width="20" />

                    Continue with Google

                </a>

                <div class="login-link">

                    Already have an account?

                    <a asp-page="/Login">
                        Login
                    </a>

                </div>

                <p class="text-danger">
                    @Model.Message
                </p>

            </div>

        </div>

    </div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 100%);
    }

    .register-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
    }

    .register-card {
        width: min(1100px, 100%);
        min-height: 700px;
        background: white;
        border-radius: 28px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.12);
    }

    .left-side {
        width: 45%;
        background: linear-gradient(rgba(79,70,229,0.8), rgba(67,56,202,0.85)), url('https://images.unsplash.com/photo-1523240795612-9a054b0db644');
        background-size: cover;
        background-position: center;
        color: white;
        display: flex;
        align-items: flex-end;
    }

    .content {
        padding: 44px;
        width: 100%;
        max-width: 420px;
    }

        .content h1 {
            font-size: 48px;
            margin: 0 0 12px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .content p {
            font-size: 18px;
            line-height: 1.5;
            margin: 0 0 24px;
            opacity: 0.95;
        }

    .features {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .feature-box {
        background: rgba(255,255,255,0.15);
        padding: 14px 16px;
        border-radius: 14px;
        backdrop-filter: blur(10px);
        font-weight: 600;
        font-size: 15px;
        line-height: 1.4;
    }

    .right-side {
        width: 55%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: white;
        padding: 32px;
    }

    .form-container {
        width: min(460px, 100%);
    }

        .form-container h2 {
            font-size: 34px;
            margin: 0 0 8px;
            color: #111827;
            letter-spacing: -0.02em;
        }

    .subtitle {
        color: #6b7280;
        margin-bottom: 28px;
        font-size: 15px;
    }

    .input-group {
        margin-bottom: 16px;
    }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #374151;
            font-size: 14px;
        }

    .custom-input {
        width: 100%;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #d1d5db;
        font-size: 16px;
        background: #fff;
        transition: 0.2s ease;
    }

        .custom-input:focus {
            border-color: #4f46e5;
            outline: none;
            box-shadow: 0 0 0 4px rgba(79,70,229,0.12);
        }

    .register-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 8px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 24px rgba(79, 70, 229, 0.22);
    }

        .register-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(79, 70, 229, 0.28);
        }

    .divider {
        text-align: center;
        margin: 22px 0;
        position: relative;
        color: #9ca3af;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.08em;
    }

        .divider::before,
        .divider::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 38%;
            height: 1px;
            background: #e5e7eb;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

    .google-btn {
        width: 100%;
        padding: 13px 14px;
        border-radius: 14px;
        border: 1px solid #d1d5db;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #111827;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .google-btn:hover {
            background: #f9fafb;
            border-color: #cbd5e1;
        }

    .login-link {
        margin-top: 22px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
    }

        .login-link a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 700;
        }

    .text-danger {
        margin-top: 16px;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .register-page {
            padding: 14px;
            align-items: stretch;
        }

        .register-card {
            flex-direction: column;
            min-height: auto;
            border-radius: 24px;
        }

        .left-side {
            width: 100%;
            min-height: 200px;
            align-items: flex-end;
        }

        .content {
            padding: 28px 24px;
            max-width: 100%;
        }

            .content h1 {
                font-size: 34px;
            }

            .content p {
                font-size: 15px;
                margin-bottom: 16px;
            }

        .features {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 10px;
        }

        .feature-box {
            flex: 1 1 calc(50% - 5px);
            min-width: 140px;
            padding: 12px 14px;
            font-size: 13px;
        }

        .right-side {
            width: 100%;
            padding: 24px 18px 30px;
        }

        .form-container h2 {
            font-size: 28px;
        }
    }

    @@media (max-width: 480px) {
        .register-page {
            padding: 10px;
        }

        .register-card {
            border-radius: 20px;
        }

        .left-side {
            min-height: 160px;
        }

        .content {
            padding: 22px 18px;
        }

            .content h1 {
                font-size: 28px;
            }

        .features {
            flex-direction: column;
            gap: 8px;
        }

        .feature-box {
            flex: none;
            width: 100%;
            padding: 10px 12px;
            font-size: 13px;
        }

        .right-side {
            padding: 20px 16px 24px;
        }

        .form-container h2 {
            font-size: 24px;
        }

        .subtitle {
            margin-bottom: 22px;
        }

        .input-group {
            margin-bottom: 14px;
        }

        .custom-input,
        .register-btn,
        .google-btn {
            border-radius: 12px;
        }

        .divider::before,
        .divider::after {
            width: 34%;
        }
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}