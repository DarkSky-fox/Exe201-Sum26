@page
@model Safexchange.Pages.Orders.IndexModel
@using Safexchange.Services
@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Lịch sử mua hàng</h1>
    <a asp-page="/Products/Index" class="btn btn-outline-primary btn-sm">Tiếp tục mua sắm</a>
</div>

@if (TempData["OrderMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model.Orders)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <span class="fw-bold text-primary">#@order.OrderId</span>
                                <span class="ms-2">@order.ProductTitle</span>
                            </div>
                            <span class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="badge @OrderDisplayHelper.OrderStatusBadgeClass(order.OrderStatus, order.ShipStatusCode)">
                                @OrderDisplayHelper.OrderStatusLabel(order.OrderStatus, order.ShipStatusCode)
                            </span>
                            <span class="badge @OrderDisplayHelper.PaymentStatusBadgeClass(order.PaymentStatus)">
                                @OrderDisplayHelper.PaymentStatusLabel(order.PaymentStatus)
                            </span>
                            @if (!string.IsNullOrEmpty(order.ShipStatusCode))
                            {
                                <span class="badge bg-light text-dark border">
                                    @OrderDisplayHelper.ShipStatusLabel(order.ShipStatusCode, order.ShipStatusName)
                                </span>
                            }
                        </div>

                        <div class="small text-muted">
                            <div><strong>Thanh toán:</strong> @OrderDisplayHelper.PaymentMethodLabel(order.PaymentMethod)</div>
                            @if (!string.IsNullOrEmpty(order.DeliveryAddress))
                            {
                                <div><strong>Giao đến:</strong> @order.DeliveryAddress</div>
                            }
                            <div><strong>Ngày đặt:</strong> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
