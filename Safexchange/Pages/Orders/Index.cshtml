@page
@model Safexchange.Pages.Orders.IndexModel
@using Safexchange.Services
@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="orders-page">

    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="page-title">
                    <i class="bi bi-bag-check me-2"></i>Lịch sử mua hàng
                </h1>
                <p class="page-subtitle">Theo dõi và quản lý các đơn hàng của bạn</p>
            </div>
            <div class="col-md-6 text-md-end">
                <a asp-page="/Products/Index" class="btn btn-outline-primary">
                    <i class="bi bi-bag-plus me-1"></i>Tiếp tục mua sắm
                </a>
            </div>
        </div>
    </div>

    <!-- Alert -->
    @if (TempData["OrderMessage"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Orders -->
    @if (!Model.Orders.Any())
    {
        <div class="empty-state-card">
            <div class="empty-icon">
                <i class="bi bi-bag-x"></i>
            </div>
            <h4>Bạn chưa có đơn hàng nào</h4>
            <p>Hãy bắt đầu mua sắm để xem đơn hàng tại đây</p>
            <a asp-page="/Products/Index" class="btn btn-primary btn-lg">
                <i class="bi bi-bag me-2"></i>Bắt đầu mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var order in Model.Orders)
            {
                <div class="order-card">
                    <div class="order-header">
                        <div class="order-info">
                            <span class="order-id">
                                <i class="bi bi-hash"></i>#@order.OrderId
                            </span>
                            <span class="order-date">
                                <i class="bi bi-calendar3 me-1"></i>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                        <div class="order-total">
                            <span class="total-label">Tổng cộng</span>
                            <span class="total-value">@order.TotalAmount.ToString("N0") đ</span>
                        </div>
                    </div>

                    <div class="order-body">
                        <div class="order-product">
                            <h5 class="product-title">@order.ProductTitle</h5>
                            <div class="product-meta">
                                <span class="payment-method">
                                    <i class="bi bi-credit-card"></i>
                                    @OrderDisplayHelper.PaymentMethodLabel(order.PaymentMethod)
                                </span>
                                @if (!string.IsNullOrEmpty(order.DeliveryAddress))
                                {
                                    <span class="delivery-address">
                                        <i class="bi bi-geo-alt"></i>
                                        @order.DeliveryAddress
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="order-status">
                            <div class="status-badges">
                                <span class="status-badge @OrderDisplayHelper.OrderStatusBadgeClass(order.OrderStatus, order.ShipStatusCode)">
                                    <i class="bi bi-clock-history"></i>
                                    @OrderDisplayHelper.OrderStatusLabel(order.OrderStatus, order.ShipStatusCode)
                                </span>
                                <span class="status-badge @OrderDisplayHelper.PaymentStatusBadgeClass(order.PaymentStatus)">
                                    <i class="bi bi-wallet2"></i>
                                    @OrderDisplayHelper.PaymentStatusLabel(order.PaymentStatus)
                                </span>
                                @if (!string.IsNullOrEmpty(order.ShipStatusCode))
                                {
                                    <span class="status-badge ship-badge">
                                        <i class="bi bi-truck"></i>
                                        @OrderDisplayHelper.ShipStatusLabel(order.ShipStatusCode, order.ShipStatusName)
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Order Status Info -->
                    <div class="order-status-info">
                        <div class="status-row">
                            <span class="status-label">Trạng thái:</span>
                            <span class="status-value">
                                <i class="bi bi-clock-history"></i>
                                @OrderDisplayHelper.OrderStatusLabel(order.OrderStatus, order.ShipStatusCode)
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .orders-page {
        padding-bottom: 2rem;
    }

    .page-header {
        background: var(--white);
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-900);
        margin-bottom: 0.25rem;
    }

    .page-title i {
        color: var(--primary);
    }

    .page-subtitle {
        color: var(--gray-500);
        margin-bottom: 0;
    }

    .orders-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .order-card {
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
        overflow: hidden;
        transition: all var(--transition-base);
    }

    .order-card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--primary);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        background: var(--gray-50);
        border-bottom: 1px solid var(--gray-100);
    }

    .order-info {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .order-id {
        font-weight: 700;
        color: var(--primary);
        font-size: 1rem;
    }

    .order-id i {
        opacity: 0.5;
    }

    .order-date {
        color: var(--gray-500);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
    }

    .order-total {
        text-align: right;
    }

    .total-label {
        display: block;
        font-size: 0.75rem;
        color: var(--gray-500);
        margin-bottom: 0.1rem;
    }

    .total-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--danger);
    }

    .order-body {
        padding: 1.25rem;
    }

    .order-product {
        margin-bottom: 1rem;
    }

    .product-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.5rem;
    }

    .product-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .payment-method,
    .delivery-address {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        color: var(--gray-500);
    }

    .order-status {
        margin-bottom: 0.5rem;
    }

    .status-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-badge i {
        font-size: 0.85rem;
    }

    .ship-badge {
        background: var(--primary-bg);
        color: var(--primary-dark);
    }

    /* Order Progress */
    .order-progress {
        padding: 1rem 1.25rem;
        background: var(--gray-50);
        border-top: 1px solid var(--gray-100);
    }

    .progress-steps {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .progress-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
    }

    .step-icon {
        width: 28px;
        height: 28px;
        background: var(--gray-300);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.75rem;
    }

    .progress-step.completed .step-icon {
        background: var(--success);
    }

    .progress-step span {
        font-size: 0.7rem;
        color: var(--gray-500);
        white-space: nowrap;
    }

    .progress-step.completed span {
        color: var(--success);
        font-weight: 500;
    }

    .progress-line {
        flex: 1;
        height: 3px;
        background: var(--gray-300);
        margin: 0 0.5rem;
        margin-bottom: 1.2rem;
        border-radius: 2px;
    }

    .progress-line.completed {
        background: var(--success);
    }

    /* Empty State */
    .empty-state-card {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--white);
        border-radius: var(--radius-lg);
        border: 1px solid var(--gray-200);
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        background: var(--gray-100);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
    }

    .empty-icon i {
        font-size: 2.5rem;
        color: var(--gray-400);
    }

    .empty-state-card h4 {
        color: var(--gray-700);
        margin-bottom: 0.5rem;
    }

    .empty-state-card p {
        color: var(--gray-500);
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .order-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .order-total {
            text-align: left;
        }

        .order-info {
            flex-direction: column;
            gap: 0.5rem;
        }

        .progress-steps {
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .progress-step span {
            display: none;
        }
    }
</style>
